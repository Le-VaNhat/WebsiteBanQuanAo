@model ThienThaiShop.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            🛒 Chi tiết đơn hàng #@Model.OrderId
        </h2>

        <a href="@Url.Action("Orders", "Admin")"
           class="btn btn-secondary">
            ← Quay lại danh sách
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- Thông tin khách hàng -->
    <div class="card mb-4">

        <div class="card-header">
            <strong>👤 Thông tin khách hàng</strong>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-2">
                    <strong>Họ tên:</strong>

                    @if (Model.User != null)
                    {
                        @Model.User.FullName
                    }
                    else
                    {
                        <span>Không xác định</span>
                    }
                </div>

                <div class="col-md-6 mb-2">
                    <strong>Email:</strong>

                    @if (Model.User != null)
                    {
                        @Model.User.Email
                    }
                    else
                    {
                        <span>Không xác định</span>
                    }
                </div>

                <div class="col-md-6 mb-2">
                    <strong>Số điện thoại:</strong>
                    @Model.Phone
                </div>

                <div class="col-md-6 mb-2">
                    <strong>Ngày đặt:</strong>
                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </div>

                <div class="col-12 mb-2">
                    <strong>Địa chỉ giao hàng:</strong>
                    @Model.ShippingAddress
                </div>

            </div>

        </div>

    </div>

    <!-- Trạng thái -->
    <div class="card mb-4">

        <div class="card-header">
            <strong>📦 Trạng thái đơn hàng</strong>
        </div>

        <div class="card-body">

            <form method="post"
                  action="@Url.Action("ChangeOrderStatus", "Admin")">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.OrderId" />

                <div class="row align-items-end">

                    <div class="col-md-5">

                        <label class="form-label">
                            Trạng thái
                        </label>

                        <select name="status"
                                class="form-control">

                            <option value="Pending"
                                    @(Model.Status == "Pending" ? "selected" : "")>
                                Chờ xác nhận
                            </option>

                            <option value="Confirmed"
                                    @(Model.Status == "Confirmed" ? "selected" : "")>
                                Đã xác nhận
                            </option>

                            <option value="Shipping"
                                    @(Model.Status == "Shipping" ? "selected" : "")>
                                Đang giao
                            </option>

                            <option value="Completed"
                                    @(Model.Status == "Completed" ? "selected" : "")>
                                Hoàn thành
                            </option>

                            <option value="Cancelled"
                                    @(Model.Status == "Cancelled" ? "selected" : "")>
                                Đã hủy
                            </option>

                        </select>

                    </div>

                    <div class="col-md-3">

                        <button type="submit"
                                class="btn btn-primary">
                            🔄 Cập nhật trạng thái
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- Chi tiết sản phẩm -->
    <div class="card mb-4">

        <div class="card-header">
            <strong>👕 Sản phẩm trong đơn</strong>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-bordered mb-0">

                    <thead class="table-dark">

                        <tr>
                            <th>Sản phẩm</th>
                            <th>Size</th>
                            <th>Số lượng</th>
                            <th>Đơn giá</th>
                            <th>Thành tiền</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var detail in Model.OrderDetails)
                        {
                            <tr>

                                <td>
                                    @if (detail.Product != null)
                                    {
                                        @detail.Product.Name
                                    }
                                    else
                                    {
                                        <span>Không xác định</span>
                                    }
                                </td>

                                <td>
                                    @if (detail.Size != null)
                                    {
                                        @detail.Size.Name
                                    }
                                    else
                                    {
                                        <span>Không xác định</span>
                                    }
                                </td>

                                <td>
                                    @detail.Quantity
                                </td>

                                <td>
                                    @detail.UnitPrice.ToString("N0") đ
                                </td>

                                <td>
                                    <strong>
                                        @((detail.UnitPrice * detail.Quantity).ToString("N0")) đ
                                    </strong>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <!-- Tổng đơn -->
    <div class="card">

        <div class="card-body">

            <div class="row">

                <div class="col-md-6">
                    <strong>Phương thức thanh toán:</strong>

                    @(string.IsNullOrWhiteSpace(Model.PaymentMethod)
                        ? "Chưa xác định"
                        : Model.PaymentMethod)
                </div>

                <div class="col-md-6 text-md-end">

                    <span class="fs-5">
                        Tổng tiền:
                    </span>

                    <strong class="fs-4">
                        @Model.TotalAmount.ToString("N0") đ
                    </strong>

                </div>

            </div>

        </div>

    </div>

</div>