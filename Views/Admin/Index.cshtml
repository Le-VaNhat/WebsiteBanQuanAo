@{
    ViewBag.Title = "Quản trị hệ thống";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .admin-page {
        padding: 40px 0;
        background: #f5f5f5;
        min-height: 80vh;
    }

    .admin-title {
        margin-bottom: 30px;
    }

        .admin-title h2 {
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .admin-title p {
            color: #777;
            margin: 0;
        }

    .admin-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .admin-card {
        background: white;
        padding: 25px;
        border-radius: 10px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.08);
    }

        .admin-card .icon {
            font-size: 32px;
            margin-bottom: 15px;
        }

        .admin-card h3 {
            font-size: 28px;
            margin: 0 0 5px;
            font-weight: 700;
        }

        .admin-card p {
            margin: 0;
            color: #777;
        }

    .admin-menu {
        background: white;
        padding: 25px;
        border-radius: 10px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.08);
    }

        .admin-menu h3 {
            margin-top: 0;
            margin-bottom: 20px;
        }

    .menu-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
    }

    .menu-item {
        display: block;
        padding: 18px;
        background: #f7f7f7;
        border-radius: 8px;
        text-decoration: none;
        color: #222;
        transition: 0.2s;
    }

        .menu-item:hover {
            background: #222;
            color: white;
            text-decoration: none;
        }

        .menu-item strong {
            display: block;
            margin-bottom: 5px;
        }

        .menu-item span {
            font-size: 13px;
            opacity: 0.7;
        }

    /* =====================================================
       NÚT CHI TIẾT DOANH THU
       ===================================================== */

    .revenue-menu-item {
        background: #fff7e6;
        border: 1px solid #ffd591;
    }

        .revenue-menu-item:hover {
            background: #d48806;
            color: white;
            border-color: #d48806;
        }

        .revenue-menu-item strong {
            color: #d48806;
        }

        .revenue-menu-item:hover strong {
            color: white;
        }

    @@media (max-width: 900px) {
        .admin-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .menu-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .admin-grid,
        .menu-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="admin-page">

    <div class="container">

        <div class="admin-title">

            <h2>Trang quản trị</h2>

            <p>
                Xin chào, @Session["FullName"]
            </p>

        </div>


        <!-- =====================================================
             THỐNG KÊ
             ===================================================== -->

        <div class="admin-grid">

            <div class="admin-card">

                <div class="icon">
                    👥
                </div>

                <h3>
                    @ViewBag.UserCount
                </h3>

                <p>
                    Khách hàng
                </p>

            </div>


            <div class="admin-card">

                <div class="icon">
                    👕
                </div>

                <h3>
                    @ViewBag.ProductCount
                </h3>

                <p>
                    Sản phẩm
                </p>

            </div>


            <div class="admin-card">

                <div class="icon">
                    📂
                </div>

                <h3>
                    @ViewBag.CategoryCount
                </h3>

                <p>
                    Danh mục
                </p>

            </div>


            <div class="admin-card">

                <div class="icon">
                    🛒
                </div>

                <h3>
                    @ViewBag.OrderCount
                </h3>

                <p>
                    Đơn hàng
                </p>

            </div>


            <div class="admin-card">

                <div class="icon">
                    ⏳
                </div>

                <h3>
                    @ViewBag.PendingOrderCount
                </h3>

                <p>
                    Đơn đang chờ xử lý
                </p>

            </div>


            <div class="admin-card">

                <div class="icon">
                    💰
                </div>

                <h3>
                    @String.Format(
                        "{0:N0} đ",
                        ViewBag.TotalRevenue
                    )
                </h3>

                <p>
                    Doanh thu
                </p>

            </div>

        </div>


        <!-- =====================================================
             MENU QUẢN TRỊ
             ===================================================== -->

        <div class="admin-menu">

            <h3>
                Quản lý hệ thống
            </h3>


            <div class="menu-grid">


                <!-- QUẢN LÝ TÀI KHOẢN -->

                <a href="@Url.Action("Users", "Admin")"
                   class="menu-item">

                    <strong>
                        👥 Quản lý tài khoản
                    </strong>

                    <span>
                        Xem, khóa/mở khóa và phân quyền tài khoản
                    </span>

                </a>


                <!-- QUẢN LÝ SẢN PHẨM -->

                <a href="@Url.Action("Products", "Admin")"
                   class="menu-item">

                    <strong>
                        👕 Quản lý sản phẩm
                    </strong>

                    <span>
                        Thêm, sửa, xóa sản phẩm và quản lý Size
                    </span>

                </a>


                <!-- QUẢN LÝ DANH MỤC -->

                <a href="@Url.Action("Categories", "Admin")"
                   class="menu-item">

                    <strong>
                        📂 Quản lý danh mục
                    </strong>

                    <span>
                        Thêm, sửa và xóa danh mục sản phẩm
                    </span>

                </a>


                <!-- QUẢN LÝ SIZE -->

                <a href="@Url.Action("Sizes", "Admin")"
                   class="menu-item">

                    <strong>
                        📏 Quản lý Size
                    </strong>

                    <span>
                        Thêm, sửa và xóa Size sản phẩm
                    </span>

                </a>


                <!-- QUẢN LÝ ĐƠN HÀNG -->

                <a href="@Url.Action("Orders", "Admin")"
                   class="menu-item">

                    <strong>
                        🛒 Quản lý đơn hàng
                    </strong>

                    <span>
                        Xem chi tiết và cập nhật trạng thái đơn hàng
                    </span>

                </a>


                <!-- QUẢN LÝ LIÊN HỆ -->

                <a href="@Url.Action("Contacts", "Admin")"
                   class="menu-item">

                    <strong>
                        📩 Quản lý liên hệ
                    </strong>

                    <span>
                        Xem và xử lý tin nhắn khách hàng
                    </span>

                </a>


                <!-- =================================================
                     CHI TIẾT DOANH THU
                     ================================================= -->

                <a href="@Url.Action("Index", "AdminReport")"
                   class="menu-item revenue-menu-item">

                    <strong>
                        📊 Chi tiết doanh thu
                    </strong>

                    <span>
                        Xem doanh thu theo sản phẩm, Size, ngày, tháng và năm
                    </span>

                </a>


            </div>

        </div>

    </div>

</div>