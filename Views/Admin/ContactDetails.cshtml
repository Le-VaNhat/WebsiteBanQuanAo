@model ThienThaiShop.Models.ContactMessage

@{
    ViewBag.Title = "Chi tiết liên hệ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .admin-page {
        padding: 40px 0;
        background: #f5f5f5;
        min-height: 80vh;
    }

    .contact-detail {
        max-width: 900px;
        margin: auto;
        background: white;
        padding: 35px;
        border-radius: 10px;
        box-shadow: 0 3px 12px rgba(0,0,0,.08);
    }

    .detail-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

        .detail-header h2 {
            margin: 0;
            font-size: 28px;
        }

    .btn {
        border: none;
        padding: 9px 15px;
        border-radius: 6px;
        text-decoration: none;
        cursor: pointer;
        display: inline-block;
        margin: 2px;
    }

        .btn:hover {
            text-decoration: none;
            opacity: .9;
        }

    .btn-black {
        background: #222;
        color: white;
    }

    .btn-red {
        background: #d9534f;
        color: white;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 25px;
    }

    .info-item {
        background: #f8f8f8;
        padding: 18px;
        border-radius: 7px;
    }

        .info-item strong {
            display: block;
            margin-bottom: 7px;
            color: #555;
        }

    .message-box {
        background: #fafafa;
        border: 1px solid #eee;
        padding: 22px;
        border-radius: 7px;
        line-height: 1.7;
        white-space: pre-wrap;
        min-height: 150px;
    }

    .detail-actions {
        margin-top: 25px;
    }

    @@media (max-width: 600px) {
        .info-grid {
            grid-template-columns: 1fr;
        }

        .detail-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }
    }
</style>

<div class="admin-page">

    <div class="container">

        <div class="contact-detail">

            <div class="detail-header">

                <h2>
                    📩 Chi tiết liên hệ
                </h2>

                <a href="@Url.Action("Contacts", "Admin")"
                   class="btn btn-black">
                    ← Quay lại
                </a>

            </div>

            <div class="info-grid">

                <div class="info-item">

                    <strong>
                        Họ và tên
                    </strong>

                    @Model.FullName

                </div>

                <div class="info-item">

                    <strong>
                        Email
                    </strong>

                    @Model.Email

                </div>

                <div class="info-item">

                    <strong>
                        Ngày gửi
                    </strong>

                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")

                </div>

                <div class="info-item">

                    <strong>
                        Trạng thái
                    </strong>

                    @if (Model.IsRead)
                    {
                        <span style="color:#3c763d;">
                            ✓ Đã đọc
                        </span>
                    }
                    else
                    {
                        <span style="color:#a94442;">
                            ● Chưa đọc
                        </span>
                    }

                </div>

            </div>

            <h3>
                Nội dung tin nhắn
            </h3>

            <div class="message-box">
                @Model.Message
            </div>

            <div class="detail-actions">

                <a href="mailto:@Model.Email"
                   class="btn btn-black">
                    ✉ Trả lời Email
                </a>

                @using (Html.BeginForm(
                    "DeleteContact",
                    "Admin",
                    FormMethod.Post,
                    new { style = "display:inline-block;" }))
                {
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.ContactMessageId" />

                    <button type="submit"
                            class="btn btn-red"
                            onclick="return confirm('Bạn có chắc muốn xóa tin nhắn này?');">
                        🗑 Xóa tin nhắn
                    </button>
                }

            </div>

        </div>

    </div>

</div>