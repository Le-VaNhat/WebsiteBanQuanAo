@model IEnumerable<ThienThaiShop.Models.Size>

@{
    ViewBag.Title = "Quản lý Size sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var product = ViewBag.Product as ThienThaiShop.Models.Product;
    var selectedSizeIds = ViewBag.SelectedSizeIds as List<int>;

    if (selectedSizeIds == null)
    {
        selectedSizeIds = new List<int>();
    }
}

<style>
    .admin-page {
        padding: 40px 0;
        background: #f5f5f5;
        min-height: 80vh;
    }

    .admin-box {
        background: #fff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 3px 12px rgba(0,0,0,.08);
        max-width: 800px;
        margin: 0 auto;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .admin-header h2 {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
        }

    .back-btn {
        background: #222;
        color: white;
        padding: 9px 15px;
        border-radius: 6px;
        text-decoration: none;
        display: inline-block;
    }

        .back-btn:hover {
            color: white;
            text-decoration: none;
            opacity: .9;
        }

    .product-info {
        background: #f8f8f8;
        padding: 18px;
        border-radius: 8px;
        margin-bottom: 25px;
    }

        .product-info strong {
            font-size: 18px;
        }

        .product-info p {
            margin: 7px 0 0;
            color: #777;
        }

    .size-list {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 25px;
    }

    .size-item {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 18px;
        background: #fafafa;
        transition: .2s;
    }

        .size-item:hover {
            border-color: #222;
            background: #f5f5f5;
        }

    .size-label {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        margin: 0;
        font-size: 17px;
        font-weight: 600;
    }

    .size-checkbox {
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    .button-area {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .btn {
        border: none;
        padding: 10px 18px;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        font-size: 14px;
    }

    .btn-save {
        background: #5cb85c;
        color: white;
    }

        .btn-save:hover {
            background: #4cae4c;
            color: white;
            text-decoration: none;
        }

    .btn-cancel {
        background: #777;
        color: white;
    }

        .btn-cancel:hover {
            background: #666;
            color: white;
            text-decoration: none;
        }

    .alert {
        padding: 12px 15px;
        border-radius: 6px;
        margin-bottom: 20px;
    }

    .alert-success {
        background: #dff0d8;
        color: #3c763d;
    }

    .alert-danger {
        background: #f2dede;
        color: #a94442;
    }

    .empty-message {
        text-align: center;
        padding: 30px;
        color: #777;
        background: #f8f8f8;
        border-radius: 8px;
    }

    @@media (max-width: 700px) {
        .admin-box {
            padding: 20px;
        }

        .admin-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .size-list {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 450px) {
        .size-list {
            grid-template-columns: 1fr;
        }

        .button-area {
            flex-direction: column;
            align-items: stretch;
        }

            .button-area .btn {
                text-align: center;
            }
    }
</style>


<div class="admin-page">

    <div class="container">

        <div class="admin-box">

            <!-- HEADER -->

            <div class="admin-header">

                <h2>
                    Quản lý Size
                </h2>

                <a href="@Url.Action("Products", "Admin")"
                   class="back-btn">
                    ← Quay lại sản phẩm
                </a>

            </div>


            <!-- THÔNG BÁO -->

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }


            <!-- THÔNG TIN SẢN PHẨM -->

            @if (product != null)
            {
                <div class="product-info">

                    <strong>
                        @product.Name
                    </strong>

                    <p>
                        Chọn các Size mà sản phẩm này đang có.
                    </p>

                </div>
            }
            else
            {
                <div class="alert alert-danger">
                    Không tìm thấy sản phẩm.
                </div>
            }


            <!-- DANH SÁCH SIZE -->

            @if (Model != null && Model.Any())
            {
                using (Html.BeginForm(
                    "ManageProductSizes",
                    "Admin",
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    if (product != null)
                    {
                        <input type="hidden"
                               name="productId"
                               value="@product.ProductId" />
                    }

                    <div class="size-list">

                        @foreach (var size in Model)
                        {
                            bool isChecked =
                                selectedSizeIds.Contains(size.SizeId);

                            <div class="size-item">

                                <label class="size-label">

                                    @if (isChecked)
                                    {
                                        <input type="checkbox"
                                               name="sizeIds"
                                               value="@size.SizeId"
                                               class="size-checkbox"
                                               checked="checked" />
                                    }
                                    else
                                    {
                                        <input type="checkbox"
                                               name="sizeIds"
                                               value="@size.SizeId"
                                               class="size-checkbox" />
                                    }

                                    <span>
                                        Size @size.Name
                                    </span>

                                </label>

                            </div>
                        }

                    </div>


                    <!-- NÚT -->

                    <div class="button-area">

                        <button type="submit"
                                class="btn btn-save">
                            💾 Lưu Size
                        </button>

                        <a href="@Url.Action("Products", "Admin")"
                           class="btn btn-cancel">
                            Hủy
                        </a>

                    </div>
                }
            }
            else
            {
                <div class="empty-message">
                    Chưa có Size nào trong hệ thống.
                </div>
            }

        </div>

    </div>

</div>