@model IEnumerable<ThienThaiShop.Models.Product>

@{
    ViewBag.Title = "Sản phẩm bán chạy - Thiên Thai Shop";
}

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f7f7f7;
        color: #222;
    }

    /* ================= HEADER ================= */

    .tt-header {
        background: #111;
        color: white;
    }

    .tt-header-inner {
        max-width: 1200px;
        height: 75px;
        margin: auto;
        padding: 0 15px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
    }

    .logo {
        color: white;
        text-decoration: none;
        font-size: 27px;
        font-weight: bold;
        letter-spacing: 1px;
        white-space: nowrap;
    }

        .logo span {
            color: #e63946;
        }

    .menu {
        display: flex;
        align-items: center;
        gap: 22px;
    }

        .menu a {
            color: white;
            text-decoration: none;
            font-size: 15px;
        }

            .menu a:hover {
                color: #e63946;
            }

    .header-icons {
        display: flex;
        align-items: center;
        gap: 15px;
    }

        .header-icons a {
            color: white;
            text-decoration: none;
            font-size: 18px;
        }

    /* ================= BANNER ================= */

    .best-banner {
        min-height: 280px;
        background: linear-gradient( 90deg, rgba(0,0,0,.75), rgba(0,0,0,.2) ), url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1800&q=80') center/cover;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
    }

        .best-banner h1 {
            font-size: 48px;
            margin-bottom: 12px;
        }

        .best-banner p {
            font-size: 18px;
        }

    /* ================= CONTAINER ================= */

    .container {
        max-width: 1200px;
        margin: auto;
        padding: 50px 15px 70px;
    }

    .section-heading {
        text-align: center;
        margin-bottom: 40px;
    }

        .section-heading h2 {
            font-size: 30px;
            margin-bottom: 10px;
        }

        .section-heading p {
            color: #777;
        }

    /* ================= GRID ================= */

    .products-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 25px;
    }

    .product-card {
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 3px 14px rgba(0,0,0,.08);
        transition: .25s;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 28px rgba(0,0,0,.14);
        }

    /* ================= IMAGE ================= */

    .product-image-wrapper {
        position: relative;
        width: 100%;
        height: 330px;
        overflow: hidden;
        background: #eee;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: .4s;
    }

    .product-card:hover
    .product-image {
        transform: scale(1.05);
    }

    .best-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: #e63946;
        color: white;
        padding: 7px 12px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
    }

    /* ================= INFO ================= */

    .product-info {
        padding: 18px;
    }

    .product-category {
        color: #888;
        font-size: 13px;
        margin-bottom: 7px;
    }

    .product-name {
        font-size: 18px;
        font-weight: bold;
        min-height: 48px;
        margin-bottom: 10px;
        line-height: 1.35;
    }

    .product-price {
        color: #e63946;
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 15px;
    }

    .detail-button {
        display: block;
        width: 100%;
        padding: 11px 15px;
        background: #111;
        color: white;
        text-align: center;
        text-decoration: none;
        border-radius: 5px;
        font-weight: bold;
        transition: .2s;
    }

        .detail-button:hover {
            background: #e63946;
            color: white;
            text-decoration: none;
        }

    /* ================= EMPTY ================= */

    .empty-products {
        background: white;
        padding: 60px 20px;
        text-align: center;
        border-radius: 8px;
    }

    /* ================= RESPONSIVE ================= */

    @@media (max-width: 1000px) {

        .products-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .menu {
            display: none;
        }
    }

    @@media (max-width: 700px) {

        .products-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .best-banner h1 {
            font-size: 36px;
        }
    }

    @@media (max-width: 500px) {

        .products-grid {
            grid-template-columns: 1fr;
        }

        .best-banner h1 {
            font-size: 30px;
        }
    }
</style>


<!-- HEADER -->

<header class="tt-header">

    <div class="tt-header-inner">

        <a href="@Url.Action("Index", "Home")"
           class="logo">

            THIÊN THAI<span>.</span>

        </a>


        <nav class="menu">

            <a href="@Url.Action("Index", "Home")">
                Trang chủ
            </a>

            <a href="@Url.Action("Index", "Product")">
                Sản phẩm
            </a>

            <a href="@Url.Action("BestSeller", "Product")">
                Bán chạy
            </a>

            <a href="@Url.Action("Contact", "Home")">
                Liên hệ
            </a>

        </nav>


        <div class="header-icons">

            <a href="@Url.Action("Index", "Product")#searchBox">
                🔍
            </a>

            <a href="#">
                👤
            </a>

            <a href="#">
                🛒
            </a>

        </div>

    </div>

</header>


<!-- BANNER -->

<section class="best-banner">

    <div>

        <h1>
            SẢN PHẨM BÁN CHẠY
        </h1>

        <p>
            Những sản phẩm được yêu thích tại Thiên Thai Shop
        </p>

    </div>

</section>


<!-- PRODUCTS -->

<section class="container">

    <div class="section-heading">

        <h2>
            TOP 20 SẢN PHẨM
        </h2>

        <p>
            Khám phá những sản phẩm nổi bật của chúng tôi
        </p>

    </div>


    @if (Model != null && Model.Any())
    {
        <div class="products-grid">

            @foreach (var item in Model)
            {
                <div class="product-card">

                    <div class="product-image-wrapper">

                        <img class="product-image"
                             src="@item.ImageUrl"
                             alt="@item.Name"
                             onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=800&q=80';" />

                        <div class="best-badge">

                            🔥 BÁN CHẠY

                        </div>

                    </div>


                    <div class="product-info">

                        <div class="product-category">

                            @(item.Category != null
                                ? item.Category.Name
                                : "Thời trang")

                        </div>


                        <div class="product-name">

                            @item.Name

                        </div>


                        <div class="product-price">

                            @item.Price.ToString("N0")₫

                        </div>


                        <a href="@Url.Action("Details", "Product",
                            new { id = item.ProductId })"
                           class="detail-button">

                            XEM CHI TIẾT →

                        </a>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-products">

            <h2>
                Chưa có sản phẩm
            </h2>

            <p>
                Hệ thống hiện chưa có sản phẩm để hiển thị.
            </p>

        </div>
    }

</section>