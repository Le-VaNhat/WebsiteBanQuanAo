@model IEnumerable<ThienThaiShop.Models.Product>

@{
    ViewBag.Title = "Sản phẩm bán chạy - Thiên Thai Shop";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f7f7f7;
        color: #222;
    }

    /* =====================================================
       BANNER
    ===================================================== */

    .best-banner {
        min-height: 320px;
        background: linear-gradient(90deg, rgba(0,0,0,.75), rgba(0,0,0,.2)), url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1800&q=80') center / cover;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
    }

        .best-banner h1 {
            font-size: 48px;
            margin: 0 0 12px;
            font-weight: bold;
        }

        .best-banner p {
            font-size: 18px;
            margin: 0;
        }

    /* =====================================================
       CONTAINER
    ===================================================== */

    .best-container {
        max-width: 1200px;
        margin: auto;
        padding: 60px 15px 40px;
    }

    /* =====================================================
       TITLE
    ===================================================== */

    .section-heading {
        text-align: center;
        margin-bottom: 40px;
    }

        .section-heading h2 {
            font-size: 32px;
            margin: 0 0 10px;
            font-weight: normal;
        }

        .section-heading p {
            color: #777;
            margin: 0;
            font-size: 15px;
        }

    /* =====================================================
       PRODUCT GRID
    ===================================================== */

    .products-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 25px;
    }

    /* =====================================================
       PRODUCT CARD
    ===================================================== */

    .product-card {
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 3px 14px rgba(0,0,0,.08);
        transition: .25s;
        position: relative;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 28px rgba(0,0,0,.14);
        }

    /* =====================================================
       IMAGE
    ===================================================== */

    .product-image-wrapper {
        position: relative;
        width: 100%;
        height: 330px;
        overflow: hidden;
        background: #eee;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: .4s;
    }

    .product-card:hover .product-image {
        transform: scale(1.05);
    }

    /* =====================================================
       BADGES
    ===================================================== */

    .best-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: #e63946;
        color: white;
        padding: 7px 12px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
        z-index: 2;
    }

    .stock-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        padding: 6px 10px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: bold;
        color: white;
        background: #198754;
        z-index: 2;
    }

    .out-stock-badge {
        background: #dc3545;
    }

    /* =====================================================
       PRODUCT INFO
    ===================================================== */

    .product-info {
        padding: 18px;
    }

    .product-category {
        color: #888;
        font-size: 13px;
        margin-bottom: 7px;
    }

    .product-name {
        font-size: 18px;
        font-weight: bold;
        min-height: 48px;
        margin-bottom: 10px;
        line-height: 1.35;
    }

    .product-description {
        color: #777;
        font-size: 13px;
        line-height: 1.5;
        height: 40px;
        overflow: hidden;
        margin-bottom: 12px;
    }

    .product-price {
        color: #e63946;
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .product-stock {
        color: #777;
        font-size: 13px;
        margin-bottom: 15px;
    }

        .product-stock strong {
            color: #222;
        }

    /* =====================================================
       BUTTON
    ===================================================== */

    .detail-button {
        display: block;
        width: 100%;
        padding: 11px 15px;
        background: #111;
        color: white;
        text-align: center;
        text-decoration: none;
        border-radius: 5px;
        font-size: 14px;
        font-weight: bold;
        transition: .2s;
    }

        .detail-button:hover {
            background: #e63946;
            color: white;
            text-decoration: none;
        }

    .disabled-button {
        display: block;
        width: 100%;
        padding: 11px 15px;
        background: #ddd;
        color: #888;
        text-align: center;
        border-radius: 5px;
        font-size: 14px;
        font-weight: bold;
        cursor: not-allowed;
    }

    /* =====================================================
       EMPTY
    ===================================================== */

    .empty-products {
        background: white;
        padding: 70px 20px;
        text-align: center;
        border-radius: 8px;
        box-shadow: 0 3px 15px rgba(0,0,0,.06);
    }

    .empty-products-icon {
        font-size: 50px;
        margin-bottom: 15px;
    }

    .empty-products h2 {
        margin: 0 0 10px;
    }

    .empty-products p {
        color: #777;
        margin: 0;
    }

    /* =====================================================
       FEATURES
    ===================================================== */

    .features-container {
        max-width: 1200px;
        margin: auto;
        padding: 20px 15px 70px;
    }

    .features {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .feature {
        background: white;
        text-align: center;
        padding: 30px 20px;
        border-radius: 6px;
        box-shadow: 0 3px 12px rgba(0,0,0,.05);
    }

    .feature-icon {
        font-size: 35px;
        margin-bottom: 15px;
    }

    .feature h3 {
        font-size: 17px;
        margin: 0 0 8px;
    }

    .feature p {
        color: #777;
        font-size: 14px;
        margin: 0;
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @@media (max-width: 1000px) {

        .products-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .features {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 700px) {

        .products-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .best-banner {
            min-height: 250px;
        }

            .best-banner h1 {
                font-size: 36px;
            }

            .best-banner p {
                font-size: 15px;
            }
    }

    @@media (max-width: 500px) {

        .products-grid {
            grid-template-columns: 1fr;
        }

        .features {
            grid-template-columns: 1fr;
        }

        .best-banner {
            min-height: 230px;
        }

            .best-banner h1 {
                font-size: 30px;
            }

            .best-banner p {
                font-size: 14px;
                padding: 0 15px;
            }

        .best-container {
            padding: 45px 15px 30px;
        }
    }
</style>


<!-- =====================================================
     BANNER
===================================================== -->

<section class="best-banner">

    <div>

        <h1>
            SẢN PHẨM BÁN CHẠY
        </h1>

        <p>
            Những sản phẩm được yêu thích tại Thiên Thai Shop
        </p>

    </div>

</section>


<!-- =====================================================
     PRODUCTS
===================================================== -->

<section class="best-container">

    <div class="section-heading">

        <h2>
            TOP 20 SẢN PHẨM
        </h2>

        <p>
            Khám phá những sản phẩm nổi bật và được yêu thích nhất
            tại Thiên Thai Shop
        </p>

    </div>


    @if (Model != null && Model.Any())
    {

        <div class="products-grid">

            @foreach (var item in Model)
            {

                <div class="product-card">

                    <!-- IMAGE -->

                    <div class="product-image-wrapper">

                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {

                            <img class="product-image"
                                 src="@item.ImageUrl"
                                 alt="@item.Name"
                                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=800&q=80';" />

                        }
                        else
                        {

                            <img class="product-image"
                                 src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=800&q=80"
                                 alt="@item.Name" />

                        }


                        <!-- BEST SELLER -->

                        <div class="best-badge">
                            🔥 BÁN CHẠY
                        </div>


                        <!-- STOCK -->

                        @if (item.Stock > 0)
                        {

                            <div class="stock-badge">
                                CÒN HÀNG
                            </div>

                        }
                        else
                        {

                            <div class="stock-badge out-stock-badge">
                                HẾT HÀNG
                            </div>

                        }

                    </div>


                    <!-- PRODUCT INFO -->

                    <div class="product-info">

                        <!-- CATEGORY -->

                        <div class="product-category">

                            @if (item.Category != null)
                            {
                                @item.Category.Name
                            }
                            else
                            {
                                <span>Thời trang</span>
                            }

                        </div>


                        <!-- NAME -->

                        <div class="product-name">
                            @item.Name
                        </div>


                        <!-- DESCRIPTION -->

                        <div class="product-description">

                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                @item.Description
                            }
                            else
                            {
                                <span>
                                    Sản phẩm thời trang Thiên Thai.
                                </span>
                            }

                        </div>


                        <!-- PRICE -->

                        <div class="product-price">
                            @item.Price.ToString("N0")₫
                        </div>


                        <!-- STOCK -->

                        <div class="product-stock">

                            Số lượng:

                            <strong>
                                @item.Stock
                            </strong>

                        </div>


                        <!-- DETAIL -->

                        @if (item.Stock > 0)
                        {

                            <a href="@Url.Action(
                                "Details",
                                "Product",
                                new { id = item.ProductId }
                            )"
                               class="detail-button">

                                XEM CHI TIẾT →

                            </a>

                        }
                        else
                        {

                            <div class="disabled-button">
                                HẾT HÀNG
                            </div>

                        }

                    </div>

                </div>

            }

        </div>

    }
    else
    {

        <div class="empty-products">

            <div class="empty-products-icon">
                🔥
            </div>

            <h2>
                Chưa có sản phẩm bán chạy
            </h2>

            <p>
                Hệ thống hiện chưa có sản phẩm để hiển thị.
            </p>

        </div>

    }

</section>


<!-- =====================================================
     FEATURES
===================================================== -->

<section class="features-container">

    <div class="features">

        <div class="feature">

            <div class="feature-icon">
                🚚
            </div>

            <h3>
                Giao hàng nhanh
            </h3>

            <p>
                Giao hàng toàn quốc
            </p>

        </div>


        <div class="feature">

            <div class="feature-icon">
                💳
            </div>

            <h3>
                Thanh toán an toàn
            </h3>

            <p>
                Nhiều phương thức thanh toán
            </p>

        </div>


        <div class="feature">

            <div class="feature-icon">
                🔄
            </div>

            <h3>
                Đổi trả dễ dàng
            </h3>

            <p>
                Hỗ trợ đổi trả sản phẩm
            </p>

        </div>


        <div class="feature">

            <div class="feature-icon">
                ☎️
            </div>

            <h3>
                Hỗ trợ 24/7
            </h3>

            <p>
                Luôn sẵn sàng hỗ trợ khách hàng
            </p>

        </div>

    </div>

</section>