@using System.Linq
@using System.Collections.Generic
@using ThienThaiShop.Models

@model IEnumerable<ThienThaiShop.Models.Product>

@{
    ViewBag.Title = "Sản phẩm - Thiên Thai Shop";

    var selectedCategory = ViewBag.SelectedCategory != null
        ? ViewBag.SelectedCategory.ToString()
        : "";

    var categories = ViewBag.Categories as List<Category>;
}

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f7f7f7;
        color: #222;
    }

    .product-page {
        min-height: 100vh;
    }

    .product-banner {
        min-height: 330px;

        background:
            linear-gradient(
                90deg,
                rgba(0,0,0,.75),
                rgba(0,0,0,.2)
            ),
            url('@Url.Content("~/Content/images/banner.jpg")')
            center/cover;

        display: flex;
        align-items: center;
        justify-content: center;

        text-align: center;
        color: white;
    }

    .product-banner-content {
        width: 1200px;
        max-width: 90%;
        margin: auto;
    }

    .product-banner h1 {
        font-size: 48px;
        margin: 0 0 15px;
        font-weight: bold;
        letter-spacing: 1px;
    }

    .product-banner p {
        font-size: 18px;
        margin: 0;
        line-height: 1.6;
    }

    .product-container {
        max-width: 1200px;
        margin: auto;
        padding: 50px 15px 70px;
    }

    .product-toolbar {
        background: white;
        padding: 22px;
        border-radius: 8px;
        box-shadow: 0 3px 15px rgba(0,0,0,.06);
        margin-bottom: 35px;
    }

    .toolbar-row {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 15px;
    }

    .search-box {
        position: relative;
    }

    .search-box input {
        width: 100%;
        height: 46px;
        border: 1px solid #ddd;
        border-radius: 5px;
        padding: 0 45px 0 15px;
        font-size: 15px;
        outline: none;
    }

    .search-box input:focus {
        border-color: #111;
        box-shadow: 0 0 0 2px rgba(0,0,0,.05);
    }

    .search-icon {
        position: absolute;
        right: 15px;
        top: 12px;
        font-size: 18px;
        pointer-events: none;
    }

    .filter-select {
        width: 100%;
        height: 46px;
        border: 1px solid #ddd;
        border-radius: 5px;
        padding: 0 12px;
        font-size: 15px;
        background: white;
        outline: none;
        cursor: pointer;
    }

    .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 25px;
        gap: 20px;
    }

    .section-heading h2 {
        margin: 0;
        font-size: 28px;
    }

    .product-count {
        color: #777;
        font-size: 14px;
        white-space: nowrap;
    }

    .products-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 25px;
    }

    .product-card {
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 3px 14px rgba(0,0,0,.08);
        transition: .25s;
        position: relative;
    }

    .product-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 10px 28px rgba(0,0,0,.14);
    }

    .product-image-wrapper {
        position: relative;
        width: 100%;
        height: 330px;
        overflow: hidden;
        background: #eee;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: .4s;
    }

    .product-card:hover .product-image {
        transform: scale(1.05);
    }

    .stock-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        padding: 6px 10px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
        color: white;
        background: #198754;
    }

    .out-stock-badge {
        background: #dc3545;
    }

    .product-info {
        padding: 18px;
    }

    .product-category {
        color: #888;
        font-size: 13px;
        margin-bottom: 7px;
    }

    .product-name {
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 10px;
        min-height: 43px;
        line-height: 1.35;
    }

    .product-description {
        color: #777;
        font-size: 13px;
        line-height: 1.5;
        height: 40px;
        overflow: hidden;
        margin-bottom: 12px;
    }

    .product-price {
        color: #e63946;
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 14px;
    }

    .product-stock {
        font-size: 13px;
        color: #777;
        margin-bottom: 15px;
    }

    .product-stock strong {
        color: #222;
    }

    .detail-button {
        display: block;
        width: 100%;
        padding: 11px 15px;
        background: #111;
        color: white;
        text-align: center;
        text-decoration: none;
        border-radius: 5px;
        font-size: 14px;
        font-weight: bold;
        transition: .2s;
    }

    .detail-button:hover {
        background: #e63946;
        color: white;
        text-decoration: none;
    }

    .disabled-button {
        display: block;
        width: 100%;
        padding: 11px 15px;
        background: #ddd;
        color: #888;
        text-align: center;
        border-radius: 5px;
        font-size: 14px;
        font-weight: bold;
    }

    .no-product {
        display: none;
        background: white;
        padding: 70px 20px;
        text-align: center;
        border-radius: 8px;
        box-shadow: 0 3px 15px rgba(0,0,0,.06);
    }

    .no-product-icon {
        font-size: 50px;
        margin-bottom: 15px;
    }

    .no-product h3 {
        margin-bottom: 10px;
        font-size: 23px;
    }

    .no-product p {
        color: #777;
        margin: 0;
    }

    @@media (max-width: 1000px) {

        .products-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .toolbar-row {
            grid-template-columns: 1fr 1fr;
        }

        .search-box {
            grid-column: span 2;
        }
    }

    @@media (max-width: 700px) {

        .products-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .toolbar-row {
            grid-template-columns: 1fr;
        }

        .search-box {
            grid-column: auto;
        }

        .product-banner {
            min-height: 260px;
        }

        .product-banner h1 {
            font-size: 36px;
        }

        .product-banner p {
            font-size: 15px;
        }

        .section-heading {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @@media (max-width: 500px) {

        .products-grid {
            grid-template-columns: 1fr;
        }

        .product-banner {
            min-height: 230px;
        }

        .product-banner h1 {
            font-size: 30px;
        }

        .product-container {
            padding-top: 30px;
        }

        .product-image-wrapper {
            height: 360px;
        }
    }

</style>

<section class="product-banner">

    <div class="product-banner-content">

        <h1>
            @(string.IsNullOrEmpty(selectedCategory)
                ? "SẢN PHẨM"
                : selectedCategory.ToUpper())
        </h1>

        <p>
            @(string.IsNullOrEmpty(selectedCategory)
                ? "Khám phá bộ sưu tập thời trang mới nhất của Thiên Thai"
                : "Khám phá các sản phẩm thuộc danh mục " + selectedCategory)
        </p>

    </div>

</section>

<main class="product-page">

    <div class="product-container">

        <div class="product-toolbar">

            <div class="toolbar-row">

                <div class="search-box" id="searchBox">

                    <input type="text"
                           id="productSearch"
                           placeholder="Tìm kiếm sản phẩm..."
                           autocomplete="off" />

                    <span class="search-icon">🔍</span>

                </div>

                <select id="categoryFilter"
                        class="filter-select">

                    <option value="">
                        Tất cả danh mục
                    </option>

                    @if (categories != null)
                    {
                        foreach (var category in categories)
                        {
                            <option value="@category.Name"
                                    @(selectedCategory == category.Name ? "selected" : "")>
                                @category.Name
                            </option>
                        }
                    }

                </select>

                <select id="priceFilter"
                        class="filter-select">

                    <option value="">
                        Tất cả mức giá
                    </option>

                    <option value="0-300000">
                        Dưới 300.000đ
                    </option>

                    <option value="300000-500000">
                        300.000đ - 500.000đ
                    </option>

                    <option value="500000-1000000">
                        500.000đ - 1.000.000đ
                    </option>

                    <option value="1000000-999999999">
                        Trên 1.000.000đ
                    </option>

                </select>

            </div>

        </div>

        <div class="section-heading">

            <h2 id="productTitle">

                @(string.IsNullOrEmpty(selectedCategory)
                    ? "Tất cả sản phẩm"
                    : selectedCategory)

            </h2>

            <div class="product-count">

                <span id="productCount">
                    @(Model == null ? 0 : Model.Count())
                </span>

                sản phẩm

            </div>

        </div>

        @if (Model != null && Model.Any())
        {
            <div class="products-grid" id="productsGrid">

                @foreach (var item in Model)
                {
                    var categoryName =
                        item.Category != null
                            ? item.Category.Name
                            : "";

                    var imageUrl =
                        !string.IsNullOrEmpty(item.ImageUrl)
                            ? item.ImageUrl
                            : Url.Content("~/Content/Images/no-image.jpg");

                    <div class="product-card"
                         data-name="@item.Name"
                         data-category="@categoryName"
                         data-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                        <div class="product-image-wrapper">

                            <img class="product-image"
                                 src="@Url.Content(imageUrl)"
                                 alt="@item.Name"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='@Url.Content("~/Content/Images/no-image.jpg")';" />

                            @if (item.Stock > 0)
                            {
                                <div class="stock-badge">
                                    CÒN HÀNG
                                </div>
                            }
                            else
                            {
                                <div class="stock-badge out-stock-badge">
                                    HẾT HÀNG
                                </div>
                            }

                        </div>

                        <div class="product-info">

                            <div class="product-category">
                                @(item.Category != null
                                    ? item.Category.Name
                                    : "Thời trang")
                            </div>

                            <div class="product-name">
                                @item.Name
                            </div>

                            <div class="product-description">
                                @(string.IsNullOrEmpty(item.Description)
                                    ? "Sản phẩm thời trang Thiên Thai."
                                    : item.Description)
                            </div>

                            <div class="product-price">
                                @item.Price.ToString("N0")đ
                            </div>

                            <div class="product-stock">

                                Số lượng:

                                <strong>
                                    @item.Stock
                                </strong>

                            </div>

                            @if (item.Stock > 0)
                            {
                                <a class="detail-button"
                                   href="@Url.Action("Details", "Product", new { id = item.ProductId })">
                                    XEM CHI TIẾT →
                                </a>
                            }
                            else
                            {
                                <div class="disabled-button">
                                    HẾT HÀNG
                                </div>
                            }

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="no-product"
                 id="noProduct"
                 style="display:block;">

                <div class="no-product-icon">
                    🔍
                </div>

                <h3>
                    Không tìm thấy sản phẩm
                </h3>

                <p>
                    Hiện tại chưa có sản phẩm phù hợp.
                </p>

            </div>
        }

    </div>

</main>

<script>

document.addEventListener("DOMContentLoaded", function () {

    var searchInput = document.getElementById("productSearch");
    var categoryFilter = document.getElementById("categoryFilter");
    var priceFilter = document.getElementById("priceFilter");

    var productCards =
        document.querySelectorAll(".product-card");

    var productCount =
        document.getElementById("productCount");

    var productTitle =
        document.getElementById("productTitle");

    var noProduct =
        document.getElementById("noProduct");

    var productsGrid =
        document.getElementById("productsGrid");


    function filterProducts() {

        var searchText =
            searchInput
                ? searchInput.value.toLowerCase().trim()
                : "";

        var selectedCategory =
            categoryFilter
                ? categoryFilter.value
                : "";

        var selectedPrice =
            priceFilter
                ? priceFilter.value
                : "";

        var visibleCount = 0;


        productCards.forEach(function (card) {

            var name =
                (card.getAttribute("data-name") || "")
                .toLowerCase();

            var category =
                card.getAttribute("data-category") || "";

            var price =
                parseFloat(
                    card.getAttribute("data-price") || "0"
                );


            var matchSearch =
                searchText === "" ||
                name.indexOf(searchText) !== -1;


            var matchCategory =
                selectedCategory === "" ||
                category === selectedCategory;


            var matchPrice = true;


            if (selectedPrice !== "") {

                var parts =
                    selectedPrice.split("-");

                var minPrice =
                    parseFloat(parts[0]);

                var maxPrice =
                    parseFloat(parts[1]);

                matchPrice =
                    price >= minPrice &&
                    price <= maxPrice;
            }


            if (
                matchSearch &&
                matchCategory &&
                matchPrice
            ) {

                card.style.display = "";
                visibleCount++;

            }
            else {

                card.style.display = "none";

            }

        });


        if (productCount) {
            productCount.textContent =
                visibleCount;
        }


        if (productTitle) {

            productTitle.textContent =
                selectedCategory === ""
                    ? "Tất cả sản phẩm"
                    : selectedCategory;

        }


        if (noProduct && productsGrid) {

            if (visibleCount === 0) {

                noProduct.style.display = "block";
                productsGrid.style.display = "none";

            }
            else {

                noProduct.style.display = "none";
                productsGrid.style.display = "grid";

            }

        }

    }


    if (searchInput) {

        searchInput.addEventListener(
            "input",
            filterProducts
        );

    }


    if (categoryFilter) {

        categoryFilter.addEventListener(
            "change",
            function () {

                var category =
                    categoryFilter.value;

                var url =
                    '@Url.Action("Index", "Product")';

                if (category !== "") {

                    url +=
                        '?category=' +
                        encodeURIComponent(category);

                }

                window.location.href = url;

            }
        );

    }


    if (priceFilter) {

        priceFilter.addEventListener(
            "change",
            filterProducts
        );

    }


    /*
     * CHỈ LỌC KHI THỰC SỰ CÓ PRODUCT CARD
     */
    if (productCards.length > 0) {

        filterProducts();

    }

});


function focusProductSearch(event) {

    if (event) {
        event.preventDefault();
    }

    var searchBox =
        document.getElementById("searchBox");

    var searchInput =
        document.getElementById("productSearch");


    if (searchBox) {

        searchBox.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });

    }


    if (searchInput) {

        setTimeout(function () {

            searchInput.focus();

        }, 400);

    }

}

</script>