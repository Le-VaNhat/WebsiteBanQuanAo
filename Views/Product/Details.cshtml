@using System.Linq
@using System.Collections.Generic
@using ThienThaiShop.Models

@model ThienThaiShop.Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var sizes = ViewBag.Sizes as List<Size>;

    if (sizes == null)
    {
        sizes = new List<Size>();
    }

    var productSizes = Model.ProductSizes ?? new HashSet<ProductSize>();

    int totalSizeStock = productSizes.Sum(x => x.Stock);

    // =====================================================
    // LẤY TỒN KHO THEO SIZE
    // =====================================================

    var stockS = productSizes
        .Where(x => x.Size != null && x.Size.Name == "S")
        .Select(x => x.Stock)
        .FirstOrDefault();

    var stockM = productSizes
        .Where(x => x.Size != null && x.Size.Name == "M")
        .Select(x => x.Stock)
        .FirstOrDefault();

    var stockL = productSizes
        .Where(x => x.Size != null && x.Size.Name == "L")
        .Select(x => x.Stock)
        .FirstOrDefault();

    var stockXL = productSizes
        .Where(x => x.Size != null && x.Size.Name == "XL")
        .Select(x => x.Stock)
        .FirstOrDefault();

    var stock2XL = productSizes
        .Where(x => x.Size != null && x.Size.Name == "2XL")
        .Select(x => x.Stock)
        .FirstOrDefault();
}

<style>
    .product-detail-page {
        background: #f7f7f7;
        padding: 50px 15px 80px;
        min-height: 80vh;
    }

    .product-detail-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .product-detail-box {
        background: #fff;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, .08);
    }

    .product-detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 45px;
    }

    /* ================= ẢNH ================= */

    .product-image-area {
        width: 100%;
    }

    .main-product-image {
        width: 100%;
        height: 620px;
        object-fit: cover;
        border-radius: 10px;
        background: #f2f2f2;
        display: block;
    }

    .no-product-image {
        width: 100%;
        height: 620px;
        background: #eee;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #888;
        font-size: 18px;
    }

    /* ================= THÔNG TIN ================= */

    .product-detail-info {
        padding: 10px 5px;
    }

    .product-category {
        color: #777;
        font-size: 14px;
        margin-bottom: 10px;
    }

    .product-detail-name {
        font-size: 36px;
        line-height: 1.2;
        font-weight: 700;
        margin: 0 0 18px;
        color: #222;
    }

    .product-price {
        color: #e63946;
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .product-description {
        color: #666;
        line-height: 1.7;
        font-size: 15px;
        margin-bottom: 25px;
        white-space: pre-line;
    }

    .stock-total {
        display: inline-block;
        padding: 8px 14px;
        border-radius: 20px;
        background: #e8f7ed;
        color: #218838;
        font-weight: 600;
        margin-bottom: 25px;
    }

        .stock-total.out-of-stock {
            background: #fbe9e9;
            color: #c62828;
        }

    /* ================= SIZE ================= */

    .size-title {
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .size-list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 25px;
    }

    .size-option {
        position: relative;
    }

        .size-option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .size-label {
        min-width: 90px;
        padding: 12px 15px;
        border: 2px solid #ddd;
        border-radius: 7px;
        background: #fff;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        transition: .2s;
        text-align: center;
    }

    .size-name {
        font-size: 16px;
        font-weight: 700;
        color: #222;
    }

    .size-stock {
        font-size: 12px;
        color: #218838;
    }

    .size-option input:checked + .size-label {
        border-color: #222;
        background: #222;
        color: #fff;
    }

        .size-option input:checked + .size-label .size-name,
        .size-option input:checked + .size-label .size-stock {
            color: #fff;
        }

    .size-option input:disabled + .size-label {
        background: #f1f1f1;
        border-color: #ddd;
        color: #aaa;
        cursor: not-allowed;
        opacity: .65;
    }

        .size-option input:disabled + .size-label .size-name {
            color: #999;
        }

        .size-option input:disabled + .size-label .size-stock {
            color: #d9534f;
        }

    /* ================= SỐ LƯỢNG ================= */

    .quantity-title {
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .quantity-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 25px;
    }

    .quantity-input {
        width: 100px;
        height: 45px;
        border: 1px solid #ccc;
        border-radius: 6px;
        text-align: center;
        font-size: 17px;
        font-weight: 600;
    }

    .quantity-hint {
        color: #777;
        font-size: 13px;
    }

    /* ================= BUTTON ================= */

    .add-cart-btn {
        width: 100%;
        border: none;
        background: #222;
        color: #fff;
        padding: 15px 20px;
        border-radius: 7px;
        font-size: 17px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s;
    }

        .add-cart-btn:hover {
            background: #e63946;
        }

        .add-cart-btn:disabled {
            background: #aaa;
            cursor: not-allowed;
        }

    .back-btn {
        display: inline-block;
        margin-top: 15px;
        width: 100%;
        text-align: center;
        padding: 13px 20px;
        border: 1px solid #222;
        color: #222;
        text-decoration: none;
        border-radius: 7px;
        font-weight: 600;
        transition: .2s;
    }

        .back-btn:hover {
            background: #222;
            color: #fff;
            text-decoration: none;
        }

    /* ================= SIZE GUIDE ================= */

    .size-guide {
        margin-top: 35px;
        border-top: 1px solid #eee;
        padding-top: 25px;
    }

        .size-guide h3 {
            font-size: 20px;
            margin-bottom: 15px;
        }

    .size-guide-table {
        width: 100%;
        border-collapse: collapse;
    }

        .size-guide-table th,
        .size-guide-table td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: center;
        }

        .size-guide-table th {
            background: #f5f5f5;
            font-weight: 700;
        }

    /* ================= THÔNG BÁO ================= */

    .select-size-message {
        display: none;
        margin-top: -15px;
        margin-bottom: 15px;
        color: #d9534f;
        font-size: 14px;
    }

    .selected-stock-message {
        display: none;
        margin-top: -15px;
        margin-bottom: 15px;
        color: #218838;
        font-size: 14px;
    }

    /* ================= RESPONSIVE ================= */

    @@media (max-width: 900px) {
        .product-detail-grid {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .main-product-image,
        .no-product-image {
            height: 500px;
        }

        .product-detail-name {
            font-size: 30px;
        }
    }

    @@media (max-width: 600px) {
        .product-detail-page {
            padding: 25px 10px 50px;
        }

        .product-detail-box {
            padding: 18px;
        }

        .main-product-image,
        .no-product-image {
            height: 400px;
        }

        .product-detail-name {
            font-size: 26px;
        }

        .product-price {
            font-size: 25px;
        }

        .size-label {
            min-width: 75px;
        }
    }
</style>


<div class="product-detail-page">

    <div class="product-detail-container">

        <div class="product-detail-box">

            <div class="product-detail-grid">

                <!-- ================================================= -->
                <!-- ẢNH SẢN PHẨM -->
                <!-- ================================================= -->

                <div class="product-image-area">

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             class="main-product-image"
                             alt="@Model.Name"
                             onerror="this.onerror=null;this.style.display='none';" />
                    }
                    else
                    {
                        <div class="no-product-image">
                            Chưa có hình ảnh
                        </div>
                    }

                </div>


                <!-- ================================================= -->
                <!-- THÔNG TIN SẢN PHẨM -->
                <!-- ================================================= -->

                <div class="product-detail-info">

                    <!-- DANH MỤC -->

                    <div class="product-category">

                        @if (Model.Category != null)
                        {
                            @Model.Category.Name
                        }
                        else
                        {
                            <span>Thời trang</span>
                        }

                    </div>


                    <!-- TÊN -->

                    <h1 class="product-detail-name">
                        @Model.Name
                    </h1>


                    <!-- GIÁ -->

                    <div class="product-price">
                        @Model.Price.ToString("N0") đ
                    </div>


                    <!-- MÔ TẢ -->

                    <div class="product-description">

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            @Model.Description
                        }
                        else
                        {
                            <span>
                                Sản phẩm thời trang Thiên Thai chất lượng cao.
                            </span>
                        }

                    </div>


                    <!-- ================================================= -->
                    <!-- TỔNG TỒN KHO -->
                    <!-- ================================================= -->

                    @if (totalSizeStock > 0)
                    {
                        <div class="stock-total">
                            Còn hàng
                        </div>
                    }
                    else
                    {
                        <div class="stock-total out-of-stock">
                            Hết hàng
                        </div>
                    }


                    <!-- ================================================= -->
                    <!-- FORM THÊM GIỎ HÀNG -->
                    <!-- ================================================= -->

                    @if (totalSizeStock > 0)
                    {
                        using (Html.BeginForm(
                            "AddToCart",
                            "Cart",
                            FormMethod.Post,
                            new { id = "addToCartForm" }))
                        {
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="productId"
                                   value="@Model.ProductId" />

                            <!-- ============================= -->
                            <!-- CHỌN SIZE -->
                            <!-- ============================= -->

                            <div class="size-title">
                                Chọn kích thước
                            </div>

                            <div class="size-list">

                                @foreach (var size in sizes)
                                {
                                    var productSize = productSizes
                                        .FirstOrDefault(
                                            x => x.SizeId == size.SizeId
                                        );

                                    int sizeStock = productSize != null
                                        ? productSize.Stock
                                        : 0;

                                    bool isAvailable = sizeStock > 0;

                                    string stockText = isAvailable
                                        ? "Còn " + sizeStock
                                        : "Hết hàng";

                                    <div class="size-option">

                                        <input type="radio"
                                               id="size_@size.SizeId"
                                               name="sizeId"
                                               value="@size.SizeId"
                                               data-stock="@sizeStock"
                                               @(isAvailable ? "" : "disabled") />

                                        <label for="size_@size.SizeId"
                                               class="size-label">

                                            <span class="size-name">
                                                @size.Name
                                            </span>

                                            <span class="size-stock">
                                                @stockText
                                            </span>

                                        </label>

                                    </div>
                                }

                            </div>


                            <div id="selectSizeMessage"
                                 class="select-size-message">
                                Vui lòng chọn kích thước trước khi thêm vào giỏ hàng.
                            </div>

                            <div id="selectedStockMessage"
                                 class="selected-stock-message">
                            </div>


                            <!-- ============================= -->
                            <!-- SỐ LƯỢNG -->
                            <!-- ============================= -->

                            <div class="quantity-title">
                                Số lượng
                            </div>

                            <div class="quantity-row">

                                <input type="number"
                                       id="quantity"
                                       name="quantity"
                                       class="quantity-input"
                                       value="1"
                                       min="1"
                                       max="1" />

                                <span id="quantityHint"
                                      class="quantity-hint">
                                    Chọn size để xem số lượng có thể mua.
                                </span>

                            </div>


                            <!-- ============================= -->
                            <!-- THÊM GIỎ HÀNG -->
                            <!-- ============================= -->

                            <button type="submit"
                                    id="addCartButton"
                                    class="add-cart-btn">

                                🛒 THÊM VÀO GIỎ HÀNG

                            </button>
                        }
                    }
                    else
                    {
                        <button type="button"
                                class="add-cart-btn"
                                disabled>

                            SẢN PHẨM ĐÃ HẾT HÀNG

                        </button>
                    }


                    <!-- ============================= -->
                    <!-- QUAY LẠI -->
                    <!-- ============================= -->

                    <a href="@Url.Action("Index", "Product")"
                       class="back-btn">

                        ← QUAY LẠI SẢN PHẨM

                    </a>


                    <!-- ================================================= -->
                    <!-- BẢNG HƯỚNG DẪN SIZE -->
                    <!-- ================================================= -->

                    <div class="size-guide">

                        <h3>
                            Hướng dẫn chọn size
                        </h3>

                        <table class="size-guide-table">

                            <thead>
                                <tr>
                                    <th>Size</th>
                                    <th>Chiều cao</th>
                                    <th>Cân nặng tham khảo</th>
                                </tr>
                            </thead>

                            <tbody>

                                <tr>
                                    <td>S</td>
                                    <td>1m55 - 1m65</td>
                                    <td>45 - 55kg</td>
                                </tr>

                                <tr>
                                    <td>M</td>
                                    <td>1m60 - 1m70</td>
                                    <td>50 - 65kg</td>
                                </tr>

                                <tr>
                                    <td>L</td>
                                    <td>1m65 - 1m75</td>
                                    <td>60 - 75kg</td>
                                </tr>

                                <tr>
                                    <td>XL</td>
                                    <td>1m70 - 1m80</td>
                                    <td>70 - 85kg</td>
                                </tr>

                                <tr>
                                    <td>2XL</td>
                                    <td>1m75 - 1m85</td>
                                    <td>80 - 100kg</td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        var sizeInputs = document.querySelectorAll(
            'input[name="sizeId"]'
        );

        var quantityInput = document.getElementById("quantity");
        var quantityHint = document.getElementById("quantityHint");
        var addCartButton = document.getElementById("addCartButton");

        var selectSizeMessage =
            document.getElementById("selectSizeMessage");

        var selectedStockMessage =
            document.getElementById("selectedStockMessage");

        var addToCartForm =
            document.getElementById("addToCartForm");


        // =====================================================
        // CẬP NHẬT SỐ LƯỢNG THEO SIZE
        // =====================================================

        function updateQuantityBySize() {

            var selectedSize = document.querySelector(
                'input[name="sizeId"]:checked'
            );

            if (!selectedSize) {

                quantityInput.value = 1;
                quantityInput.min = 1;
                quantityInput.max = 1;

                quantityHint.innerHTML =
                    "Chọn size để xem số lượng có thể mua.";

                selectedStockMessage.style.display = "none";

                return;
            }


            var stock = parseInt(
                selectedSize.getAttribute("data-stock")
            );


            if (isNaN(stock) || stock <= 0) {

                quantityInput.value = 1;
                quantityInput.min = 1;
                quantityInput.max = 1;

                quantityHint.innerHTML =
                    "Size này đã hết hàng.";

                selectedStockMessage.style.display = "block";
                selectedStockMessage.innerHTML =
                    "Size này hiện đã hết hàng.";

                return;
            }


            // Đặt giới hạn số lượng
            quantityInput.min = 1;
            quantityInput.max = stock;


            // Nếu số lượng hiện tại lớn hơn tồn kho
            if (parseInt(quantityInput.value) > stock) {
                quantityInput.value = stock;
            }


            // Nếu số lượng không hợp lệ
            if (parseInt(quantityInput.value) < 1 ||
                isNaN(parseInt(quantityInput.value))) {

                quantityInput.value = 1;
            }


            quantityHint.innerHTML =
                "Tối đa " + stock + " sản phẩm cho size này.";


            selectedStockMessage.style.display = "block";
            selectedStockMessage.innerHTML =
                "Size đang chọn còn " + stock + " sản phẩm.";

        }


        // =====================================================
        // KHI CHỌN SIZE
        // =====================================================

        sizeInputs.forEach(function (input) {

            input.addEventListener("change", function () {

                selectSizeMessage.style.display = "none";

                updateQuantityBySize();

            });

        });


        // =====================================================
        // KHÔNG CHO NHẬP QUÁ TỒN KHO
        // =====================================================

        if (quantityInput) {

            quantityInput.addEventListener("input", function () {

                var selectedSize = document.querySelector(
                    'input[name="sizeId"]:checked'
                );

                if (!selectedSize) {
                    quantityInput.value = 1;
                    return;
                }


                var stock = parseInt(
                    selectedSize.getAttribute("data-stock")
                );


                var quantity = parseInt(
                    quantityInput.value
                );


                if (isNaN(quantity) || quantity < 1) {
                    quantityInput.value = 1;
                }


                if (quantity > stock) {
                    quantityInput.value = stock;
                }

            });

        }


        // =====================================================
        // KIỂM TRA TRƯỚC KHI THÊM GIỎ
        // =====================================================

        if (addToCartForm) {

            addToCartForm.addEventListener("submit", function (event) {

                var selectedSize = document.querySelector(
                    'input[name="sizeId"]:checked'
                );


                // Chưa chọn size
                if (!selectedSize) {

                    event.preventDefault();

                    selectSizeMessage.style.display = "block";

                    return false;
                }


                var stock = parseInt(
                    selectedSize.getAttribute("data-stock")
                );


                var quantity = parseInt(
                    quantityInput.value
                );


                // Size hết hàng
                if (isNaN(stock) || stock <= 0) {

                    event.preventDefault();

                    alert("Size này đã hết hàng.");

                    return false;
                }


                // Số lượng không hợp lệ
                if (isNaN(quantity) ||
                    quantity < 1) {

                    event.preventDefault();

                    alert("Số lượng không hợp lệ.");

                    return false;
                }


                // Mua vượt tồn kho
                if (quantity > stock) {

                    event.preventDefault();

                    alert(
                        "Size này chỉ còn " +
                        stock +
                        " sản phẩm."
                    );

                    quantityInput.value = stock;

                    return false;
                }

            });

        }

    });

</script>