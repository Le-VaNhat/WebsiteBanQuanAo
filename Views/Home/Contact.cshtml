@model ThienThaiShop.Models.ContactMessage

@{
    ViewBag.Title = "Liên hệ - Thiên Thai Shop";
}

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f5f5f5;
        color: #222;
    }

    /* ================= BANNER ================= */

    .contact-banner {
        min-height: 350px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;

        background:
            linear-gradient(
                90deg,
                rgba(0,0,0,.75),
                rgba(0,0,0,.35)
            ),
            url('@Url.Content("~/Content/Images/1.jpg")')
            center center / cover no-repeat;

        color: white;
    }

    .contact-banner h1 {
        font-size: 48px;
        margin: 0 0 15px;
    }

    .contact-banner p {
        font-size: 18px;
        margin: 0;
    }

    /* ================= CONTENT ================= */

    .contact-container {
        max-width: 1000px;
        margin: auto;
        padding: 70px 15px;
    }

    .contact-box {
        background: white;
        border-radius: 10px;
        padding: 50px;

        box-shadow: 0 5px 25px rgba(0,0,0,.08);

        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 50px;
    }

    /* ================= INFO ================= */

    .contact-info h2 {
        margin-top: 0;
        font-size: 30px;
    }

    .contact-info > p {
        color: #777;
        line-height: 1.7;
        margin-bottom: 30px;
    }

    .contact-item {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 25px;
    }

    .contact-icon {
        width: 45px;
        height: 45px;

        background: #111;
        color: white;

        border-radius: 50%;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 20px;
        flex-shrink: 0;
    }

    .contact-detail h3 {
        margin: 0 0 5px;
        font-size: 16px;
    }

    .contact-detail p,
    .contact-detail a {
        margin: 0;
        color: #777;
        text-decoration: none;
    }

    .contact-detail a:hover {
        color: #e63946;
    }

    /* ================= FORM ================= */

    .contact-form h2 {
        margin-top: 0;
        font-size: 30px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        display: block;
        margin-bottom: 7px;
        font-weight: bold;
        font-size: 14px;
    }

    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 13px;

        border: 1px solid #ddd;
        border-radius: 5px;

        font-size: 15px;
        outline: none;
        font-family: Arial, Helvetica, sans-serif;
    }

    .form-group input:focus,
    .form-group textarea:focus {
        border-color: #111;
    }

    .form-group textarea {
        height: 130px;
        resize: vertical;
    }

    .contact-button {
        border: none;
        background: #e63946;
        color: white;

        padding: 14px 30px;
        border-radius: 5px;

        font-size: 15px;
        font-weight: bold;

        cursor: pointer;
    }

    .contact-button:hover {
        background: #c92532;
    }

    /* ================= MESSAGE ================= */

    .contact-success {
        margin-bottom: 20px;
        padding: 14px 16px;
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
        border-radius: 5px;
    }

    .contact-error {
        margin-bottom: 20px;
        padding: 14px 16px;
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
        border-radius: 5px;
    }

    .field-error {
        display: block;
        margin-top: 5px;
        color: #e63946;
        font-size: 13px;
    }

    /* ================= RESPONSIVE ================= */

    @@media (max-width: 700px) {

        .contact-box {
            grid-template-columns: 1fr;
            padding: 30px;
            gap: 35px;
        }

        .contact-banner h1 {
            font-size: 36px;
        }

    }

</style>

<!-- ================= BANNER ================= -->

<section class="contact-banner">

    <div>

        <h1>LIÊN HỆ</h1>

        <p>
            Thiên Thai Shop luôn sẵn sàng hỗ trợ bạn
        </p>

    </div>

</section>

<!-- ================= CONTACT ================= -->

<main class="contact-container">

    <div class="contact-box">

        <!-- ================= THÔNG TIN ================= -->

        <div class="contact-info">

            <h2>Thông tin liên hệ</h2>

            <p>
                Nếu bạn có bất kỳ câu hỏi nào về sản phẩm,
                đơn hàng hoặc cần hỗ trợ, hãy liên hệ với
                Thiên Thai Shop. Chúng tôi sẽ cố gắng phản hồi
                bạn trong thời gian sớm nhất.
            </p>

            <div class="contact-item">

                <div class="contact-icon">
                    📍
                </div>

                <div class="contact-detail">

                    <h3>Địa chỉ</h3>

                    <p>
                        Hà Nội, Việt Nam
                    </p>

                </div>

            </div>

            <div class="contact-item">

                <div class="contact-icon">
                    📞
                </div>

                <div class="contact-detail">

                    <h3>Số điện thoại</h3>

                    <a href="tel:0762379122">
                        0762379122
                    </a>

                </div>

            </div>

            <div class="contact-item">

                <div class="contact-icon">
                    ✉
                </div>

                <div class="contact-detail">

                    <h3>Email</h3>

                    <a href="mailto:nle05249@gmail.com">
                        nle05249@gmail.com
                    </a>

                </div>

            </div>

        </div>

        <!-- ================= FORM ================= -->

        <div class="contact-form">

            <h2>Gửi tin nhắn</h2>

            <!-- THÔNG BÁO GỬI THÀNH CÔNG -->

            @if (TempData["ContactSuccess"] != null)
            {
                <div class="contact-success">
                    @TempData["ContactSuccess"]
                </div>
            }

            <!-- FORM GỬI LIÊN HỆ -->

            @using (Html.BeginForm(
                "Send",
                "Contact",
                FormMethod.Post,
                new { @class = "contact-form-submit" }
            ))
            {
                @Html.AntiForgeryToken()

                <!-- THÔNG BÁO LỖI -->

                @Html.ValidationSummary(
                    true,
                    "",
                    new { @class = "contact-error" }
                )

                <!-- HỌ TÊN -->

                <div class="form-group">

                    <label for="FullName">
                        Họ và tên
                    </label>

                    @Html.TextBoxFor(
                        m => m.FullName,
                        new
                        {
                            id = "FullName",
                            placeholder = "Nhập họ và tên",
                            autocomplete = "name"
                        }
                    )

                    @Html.ValidationMessageFor(
                        m => m.FullName,
                        "",
                        new { @class = "field-error" }
                    )

                </div>

                <!-- EMAIL -->

                <div class="form-group">

                    <label for="Email">
                        Email
                    </label>

                    @Html.TextBoxFor(
                        m => m.Email,
                        new
                        {
                            id = "Email",
                            type = "email",
                            placeholder = "Nhập email",
                            autocomplete = "email"
                        }
                    )

                    @Html.ValidationMessageFor(
                        m => m.Email,
                        "",
                        new { @class = "field-error" }
                    )

                </div>

                <!-- NỘI DUNG -->

                <div class="form-group">

                    <label for="Message">
                        Nội dung
                    </label>

                    @Html.TextAreaFor(
                        m => m.Message,
                        new
                        {
                            id = "Message",
                            placeholder = "Nhập nội dung bạn muốn gửi"
                        }
                    )

                    @Html.ValidationMessageFor(
                        m => m.Message,
                        "",
                        new { @class = "field-error" }
                    )

                </div>

                <!-- NÚT GỬI -->

                <button type="submit"
                        class="contact-button">

                    GỬI LIÊN HỆ

                </button>
            }

        </div>

    </div>

</main>