<!-- =====================================================
     JAVASCRIPT
===================================================== -->

<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {


            /* =================================================
               SEARCH
            ================================================= */

            var searchToggle =
                document.getElementById(
                    "searchToggle"
                );


            var homeSearch =
                document.getElementById(
                    "homeSearch"
                );


            var homeSearchInput =
                document.getElementById(
                    "homeSearchInput"
                );


            if (
                searchToggle &&
                homeSearch &&
                homeSearchInput
            ) {


                searchToggle.addEventListener(
                    "click",
                    function () {


                        homeSearch.classList.toggle(
                            "active"
                        );


                        if (
                            homeSearch.classList.contains(
                                "active"
                            )
                        ) {


                            setTimeout(
                                function () {

                                    homeSearchInput.focus();

                                },
                                100
                            );

                        }

                    }
                );

            }

        }
    );

</script>