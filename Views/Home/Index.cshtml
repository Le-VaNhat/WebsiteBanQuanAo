@using System.Linq
@using System.Collections.Generic
@using ThienThaiShop.Models

@{
    ViewBag.Title = "Thiên Thai Shop";

    var products = ViewBag.Products as List<Product>;
    var categories = ViewBag.Categories as List<Category>;

    // =====================================================
    // 4 DANH MỤC CỐ ĐỊNH CỦA CỬA HÀNG
    // =====================================================

    var categoryNames = new[]
    {
        "Áo nam",
        "Quần nam",
        "Áo nữ",
        "Quần nữ"
    };

    // =====================================================
    // ẢNH ĐẠI DIỆN CHO 4 DANH MỤC
    // =====================================================

    var categoryImages = new[]
    {
        "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=800&q=80",
        "https://images.unsplash.com/photo-1542272604-787c3835535d?auto=format&fit=crop&w=800&q=80",
        "https://images.unsplash.com/photo-1485968579580-b6d095142e6e?auto=format&fit=crop&w=800&q=80",
        "https://images.unsplash.com/photo-1506629905607-d9c297d2e7a5?auto=format&fit=crop&w=800&q=80"
    };
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f8f8f8;
        color: #222;
    }

    /* ================= HERO ================= */

    .hero {
        min-height: 500px;
        background: linear-gradient(90deg, rgba(0,0,0,.7), rgba(0,0,0,.15)), url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1800&q=80') center / cover;
        display: flex;
        align-items: center;
    }

    .hero-content {
        width: 1200px;
        max-width: 90%;
        margin: auto;
        color: white;
    }

        .hero-content h1 {
            font-size: 55px;
            margin: 0 0 15px;
            font-weight: 700;
        }

        .hero-content p {
            font-size: 20px;
            max-width: 550px;
            line-height: 1.6;
            margin-bottom: 30px;
        }

    .btn-shop {
        display: inline-block;
        padding: 15px 32px;
        background: #e63946;
        color: white;
        text-decoration: none;
        font-weight: bold;
        border-radius: 4px;
        transition: .2s;
    }

        .btn-shop:hover {
            background: #c92532;
            color: white;
            text-decoration: none;
        }


    /* ================= CONTAINER ================= */

    .container-tt {
        max-width: 1200px;
        margin: auto;
        padding: 60px 15px;
    }

    .section-title {
        text-align: center;
        margin-bottom: 40px;
    }

        .section-title h2 {
            font-size: 32px;
            margin-bottom: 10px;
        }

        .section-title p {
            color: #777;
        }


    /* ================= DANH MỤC ================= */

    .categories {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .category {
        height: 260px;
        position: relative;
        overflow: hidden;
        border-radius: 8px;
        cursor: pointer;
        display: block;
        box-shadow: 0 4px 15px rgba(0,0,0,.1);
        background: #ddd;
        text-decoration: none;
    }

        .category img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: .4s;
        }

        .category:hover img {
            transform: scale(1.08);
        }

    .category-overlay {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 55%;
        background: linear-gradient( transparent, rgba(0,0,0,.85) );
        display: flex;
        align-items: flex-end;
        padding: 20px;
    }

    .category-title {
        color: white;
        font-size: 22px;
        font-weight: bold;
    }


    /* ================= SẢN PHẨM ================= */

    .products {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 25px;
    }

    .product {
        background: white;
        border-radius: 6px;
        overflow: hidden;
        box-shadow: 0 3px 12px rgba(0,0,0,.08);
        transition: .25s;
    }

        .product:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,.15);
        }

    .product-img {
        width: 100%;
        height: 330px;
        object-fit: cover;
        display: block;
    }

    .product-info {
        padding: 18px;
    }

    .product-category {
        color: #888;
        font-size: 13px;
        margin-bottom: 7px;
    }

    .product-name {
        font-size: 17px;
        font-weight: bold;
        margin-bottom: 10px;
        min-height: 40px;
    }

    .product-description {
        color: #777;
        font-size: 13px;
        line-height: 1.5;
        height: 40px;
        overflow: hidden;
        margin-bottom: 12px;
    }

    .product-price {
        color: #e63946;
        font-size: 18px;
        font-weight: bold;
    }

    .product-stock {
        margin-top: 12px;
        color: #777;
        font-size: 13px;
    }

        .product-stock strong {
            color: #222;
        }

    .product-btn {
        display: block;
        margin-top: 15px;
        padding: 10px;
        text-align: center;
        border: 1px solid #222;
        color: #222;
        text-decoration: none;
        border-radius: 4px;
        transition: .2s;
        font-weight: bold;
    }

        .product-btn:hover {
            background: #111;
            color: white;
            text-decoration: none;
        }

    .empty-products {
        grid-column: 1 / -1;
        background: white;
        padding: 50px;
        text-align: center;
        border-radius: 6px;
    }

        .empty-products h3 {
            margin-bottom: 10px;
        }

        .empty-products p {
            color: #777;
        }


    /* ================= BANNER ================= */

    .banner {
        margin-top: 20px;
        background: linear-gradient(90deg, rgba(0,0,0,.75), rgba(0,0,0,.1)), url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1800&q=80') center / cover;
        min-height: 300px;
        display: flex;
        align-items: center;
        padding: 50px;
        color: white;
        border-radius: 8px;
    }

        .banner h2 {
            font-size: 38px;
            margin-bottom: 15px;
        }

        .banner p {
            font-size: 17px;
            margin-bottom: 25px;
        }


    /* ================= ƯU ĐIỂM ================= */

    .features {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-top: 30px;
    }

    .feature {
        background: white;
        text-align: center;
        padding: 30px 20px;
        border-radius: 6px;
        box-shadow: 0 3px 12px rgba(0,0,0,.05);
    }

    .feature-icon {
        font-size: 35px;
        margin-bottom: 15px;
    }

    .feature h3 {
        font-size: 17px;
        margin-bottom: 8px;
    }

    .feature p {
        color: #777;
        font-size: 14px;
    }


    /* ================= RESPONSIVE ================= */

    @@media (max-width: 900px) {

        .categories,
        .products,
        .features {
            grid-template-columns: repeat(2, 1fr);
        }

        .hero-content h1 {
            font-size: 40px;
        }
    }


    @@media (max-width: 600px) {

        .categories,
        .products,
        .features {
            grid-template-columns: 1fr;
        }

        .hero {
            min-height: 400px;
        }

        .hero-content h1 {
            font-size: 32px;
        }

        .hero-content p {
            font-size: 16px;
        }

        .banner {
            padding: 30px;
        }

            .banner h2 {
                font-size: 28px;
            }
    }
</style>


<!-- ================= HERO ================= -->

<section class="hero">

    <div class="hero-content">

        <h1>
            THỜI TRANG THIÊN THAI
        </h1>

        <p>
            Khám phá bộ sưu tập thời trang mới nhất.
            Phong cách hiện đại, chất lượng cao và phù hợp
            với mọi cá tính.
        </p>

        <a href="@Url.Action("Index", "Product")"
           class="btn-shop">

            MUA SẮM NGAY

        </a>

    </div>

</section>


<!-- ================= DANH MỤC ================= -->

<section class="container-tt">

    <div class="section-title">

        <h2>
            Danh mục sản phẩm
        </h2>

        <p>
            Khám phá phong cách phù hợp với bạn
        </p>

    </div>


    <div class="categories">

        <!-- ================= ÁO NAM ================= -->

        <a href="@Url.Action(
                    "Index",
                    "Product",
                    new
                    {
                        category = "Áo nam"
                    }
                 )"
           class="category">

            <img src="@categoryImages[0]"
                 alt="Áo nam"
                 onerror="this.onerror=null;this.style.display='none';" />

            <div class="category-overlay">

                <div class="category-title">
                    Áo nam
                </div>

            </div>

        </a>


        <!-- ================= QUẦN NAM ================= -->

        <a href="@Url.Action(
                    "Index",
                    "Product",
                    new
                    {
                        category = "Quần nam"
                    }
                 )"
           class="category">

            <img src="@categoryImages[1]"
                 alt="Quần nam"
                 onerror="this.onerror=null;this.style.display='none';" />

            <div class="category-overlay">

                <div class="category-title">
                    Quần nam
                </div>

            </div>

        </a>


        <!-- ================= ÁO NỮ ================= -->

        <a href="@Url.Action(
                    "Index",
                    "Product",
                    new
                    {
                        category = "Áo nữ"
                    }
                 )"
           class="category">

            <img src="@categoryImages[2]"
                 alt="Áo nữ"
                 onerror="this.onerror=null;this.style.display='none';" />

            <div class="category-overlay">

                <div class="category-title">
                    Áo nữ
                </div>

            </div>

        </a>


        <!-- ================= QUẦN NỮ ================= -->

        <a href="@Url.Action(
                    "Index",
                    "Product",
                    new
                    {
                        category = "Quần nữ"
                    }
                 )"
           class="category">

            <img src="@categoryImages[3]"
                 alt="Quần nữ"
                 onerror="this.onerror=null;this.style.display='none';" />

            <div class="category-overlay">

                <div class="category-title">
                    Quần nữ
                </div>

            </div>

        </a>

    </div>

</section>


<!-- ================= SẢN PHẨM NỔI BẬT ================= -->

<section class="container-tt">

    <div class="section-title">

        <h2>
            Sản phẩm nổi bật
        </h2>

        <p>
            Những sản phẩm mới nhất tại Thiên Thai
        </p>

    </div>


    <div class="products">

        @if (products != null && products.Any())
        {
            foreach (var product in products)
            {
                <div class="product">

                    <!-- ================= ẢNH SẢN PHẨM ================= -->

                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img class="product-img"
                             src="@product.ImageUrl"
                             alt="@product.Name"
                             onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=800&q=80';" />
                    }
                    else
                    {
                        <img class="product-img"
                             src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=800&q=80"
                             alt="@product.Name" />
                    }


                    <div class="product-info">

                        <!-- ================= DANH MỤC ================= -->

                        <div class="product-category">

                            @if (product.Category != null &&
                                categoryNames.Contains(product.Category.Name))
                            {
                                @product.Category.Name
                            }
                            else
                            {
                                <span>
                                    Thời trang
                                </span>
                            }

                        </div>


                        <!-- ================= TÊN SẢN PHẨM ================= -->

                        <div class="product-name">
                            @product.Name
                        </div>


                        <!-- ================= MÔ TẢ ================= -->

                        <div class="product-description">

                            @if (!string.IsNullOrEmpty(product.Description))
                            {
                                @product.Description
                            }
                            else
                            {
                                <span>
                                    Sản phẩm thời trang Thiên Thai.
                                </span>
                            }

                        </div>


                        <!-- ================= GIÁ ================= -->

                        <div class="product-price">
                            @product.Price.ToString("N0") đ
                        </div>


                        <!-- ================= SỐ LƯỢNG ================= -->

                        <div class="product-stock">

                            Số lượng:

                            <strong>
                                @product.Stock
                            </strong>

                        </div>


                        <!-- ================= XEM CHI TIẾT ================= -->

                        <a href="@Url.Action(
                                    "Details",
                                    "Product",
                                    new
                                    {
                                        id = product.ProductId
                                    }
                                 )"
                           class="product-btn">

                            XEM CHI TIẾT →

                        </a>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="empty-products">

                <h3>
                    Chưa có sản phẩm
                </h3>

                <p>
                    Hiện tại chưa có sản phẩm nào trong hệ thống.
                </p>

            </div>
        }

    </div>

</section>


<!-- ================= BANNER ================= -->

<section class="container-tt">

    <div class="banner">

        <div>

            <h2>
                BỘ SƯU TẬP MỚI 2026
            </h2>

            <p>
                Cập nhật xu hướng thời trang mới nhất.
                Ưu đãi hấp dẫn dành cho khách hàng Thiên Thai.
            </p>

            <a href="@Url.Action("Index", "Product")"
               class="btn-shop">

                KHÁM PHÁ NGAY

            </a>

        </div>

    </div>

</section>


<!-- ================= ƯU ĐIỂM ================= -->

<section class="container-tt">

    <div class="features">

        <div class="feature">

            <div class="feature-icon">
                🚚
            </div>

            <h3>
                Giao hàng nhanh
            </h3>

            <p>
                Giao hàng toàn quốc
            </p>

        </div>


        <div class="feature">

            <div class="feature-icon">
                💳
            </div>

            <h3>
                Thanh toán an toàn
            </h3>

            <p>
                Nhiều phương thức thanh toán
            </p>

        </div>


        <div class="feature">

            <div class="feature-icon">
                🔄
            </div>

            <h3>
                Đổi trả dễ dàng
            </h3>

            <p>
                Hỗ trợ đổi trả sản phẩm
            </p>

        </div>


        <div class="feature">

            <div class="feature-icon">
                📞
            </div>

            <h3>
                Hỗ trợ 24/7
            </h3>

            <p>
                Luôn sẵn sàng hỗ trợ khách hàng
            </p>

        </div>

    </div>

</section>