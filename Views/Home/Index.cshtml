<!-- =====================================================
     SẢN PHẨM NỔI BẬT
===================================================== -->

<section class="container-tt">


    <div class="section-title">

        <h2>
            Sản phẩm nổi bật
        </h2>

        <p>
            Những sản phẩm mới nhất tại Thiên Thai
        </p>

    </div>


    <div class="products">


        @if (products != null && products.Any())
        {

            foreach (var product in products)
            {

                <div class="product">


                    <!-- HÌNH SẢN PHẨM -->

                    <img class="product-img"
                         src="@(
                            string.IsNullOrEmpty(product.ImageUrl)
                            ? Url.Content("~/Content/Images/no-image.jpg")
                            : product.ImageUrl
                         )"
                         alt="@product.Name"
                         onerror="this.onerror=null;this.src='@Url.Content("~/Content/Images/no-image.jpg")';">


                    <div class="product-info">


                        <!-- TÊN -->

                        <div class="product-name">

                            @product.Name

                        </div>


                        <!-- GIÁ -->

                        <span class="product-price">

                            @product.Price.ToString("N0")₫

                        </span>


                        <!-- CHI TIẾT -->

                        <a href="@Url.Action(
                                    "Details",
                                    "Product",
                                    new
                                    {
                                        id = product.ProductId
                                    }
                                 )"
                           class="product-btn">

                            Xem sản phẩm

                        </a>

                    </div>

                </div>

            }

        }
        else
        {

            <div class="empty-products">

                <h3>

                    Chưa có sản phẩm

                </h3>

                <p>

                    Hiện tại chưa có sản phẩm nào
                    trong hệ thống.

                </p>

            </div>

        }

    </div>

</section>


