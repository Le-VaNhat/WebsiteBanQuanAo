@using System.Linq
@using System.Collections.Generic
@using ThienThaiShop.Models

@{
    ViewBag.Title = "Thiên Thai Shop";

    var products = ViewBag.Products as List<Product>;
    var categories = ViewBag.Categories as List<Category>;
}

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f8f8f8;
        color: #222;
    }


    /* =====================================================
       HEADER
    ===================================================== */

    .tt-header {
        background: #111;
        color: white;
        padding: 0;
    }

    .tt-header-inner {
        max-width: 1200px;
        margin: auto;
        height: 75px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 30px;
        padding: 0 15px;
    }

    .logo {
        font-size: 28px;
        font-weight: bold;
        color: white;
        text-decoration: none;
        letter-spacing: 1px;
        white-space: nowrap;
    }

    .logo span {
        color: #e63946;
    }

    .menu {
        display: flex;
        gap: 25px;
        align-items: center;
    }

    .menu a {
        color: white;
        text-decoration: none;
        font-size: 15px;
        transition: .2s;
    }

    .menu a:hover {
        color: #e63946;
    }


    /* =====================================================
       HEADER ICONS
    ===================================================== */

    .header-icons {
        display: flex;
        gap: 15px;
        align-items: center;
    }

    .header-icons a {
        color: white;
        text-decoration: none;
        font-size: 18px;
        cursor: pointer;
        transition: .2s;

        display: flex;
        align-items: center;
    }

    .header-icons a:hover {
        color: #e63946;
    }

    .user-name {
        font-size: 13px;
        margin-left: 5px;
        max-width: 110px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }


    /* =====================================================
       SEARCH BAR
    ===================================================== */

    .home-search {
        display: none;
        background: #fff;
        padding: 15px;
        border-bottom: 1px solid #ddd;
    }

    .home-search.active {
        display: block;
    }

    .home-search-form {
        max-width: 1200px;
        margin: auto;

        display: flex;
        gap: 10px;

        padding: 0 15px;
    }

    .home-search-form input {
        flex: 1;

        height: 45px;

        border: 1px solid #ddd;
        border-radius: 5px;

        padding: 0 15px;

        font-size: 15px;
        outline: none;
    }

    .home-search-form input:focus {
        border-color: #111;
    }

    .home-search-form button {
        height: 45px;

        padding: 0 25px;

        border: none;
        background: #111;
        color: white;

        border-radius: 5px;

        cursor: pointer;
        font-weight: bold;

        transition: .2s;
    }

    .home-search-form button:hover {
        background: #e63946;
    }


    /* =====================================================
       HERO
    ===================================================== */

    .hero {
        min-height: 500px;

        background:
            linear-gradient(
                90deg,
                rgba(0,0,0,.7),
                rgba(0,0,0,.15)
            ),
            url('@Url.Content("~/Content/images/banner.jpg")')
            center/cover;

        display: flex;
        align-items: center;
    }

    .hero-content {
        width: 1200px;
        max-width: 90%;
        margin: auto;

        color: white;
    }

    .hero-content h1 {
        font-size: 55px;
        margin: 0 0 15px;
        font-weight: 700;
    }

    .hero-content p {
        font-size: 20px;
        max-width: 550px;
        line-height: 1.6;
        margin-bottom: 30px;
    }

    .btn-shop {
        display: inline-block;

        padding: 15px 32px;

        background: #e63946;
        color: white;

        text-decoration: none;
        font-weight: bold;

        border-radius: 4px;

        transition: .2s;
    }

    .btn-shop:hover {
        background: #c92532;
        color: white;
        text-decoration: none;
    }


    /* =====================================================
       CONTAINER
    ===================================================== */

    .container-tt {
        max-width: 1200px;
        margin: auto;

        padding: 60px 15px;
    }

    .section-title {
        text-align: center;
        margin-bottom: 40px;
    }

    .section-title h2 {
        font-size: 32px;
        margin-bottom: 10px;
    }

    .section-title p {
        color: #777;
    }


    /* =====================================================
       DANH MỤC
    ===================================================== */

    .categories {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .category {
        height: 300px;

        position: relative;
        overflow: hidden;

        border-radius: 8px;

        cursor: pointer;

        display: block;

        background: #ddd;

        text-decoration: none;
    }

    .category img {
        width: 100%;
        height: 100%;

        object-fit: cover;

        display: block;

        transition: .4s;
    }

    .category:hover img {
        transform: scale(1.08);
    }

    .category-title {
        position: absolute;

        bottom: 0;
        left: 0;
        right: 0;

        padding: 22px 20px;

        background:
            linear-gradient(
                transparent,
                rgba(0,0,0,.85)
            );

        color: white;

        font-size: 22px;
        font-weight: bold;
    }


    /* =====================================================
       PRODUCTS
    ===================================================== */

    .products {
        display: grid;

        grid-template-columns:
            repeat(4, 1fr);

        gap: 25px;
    }

    .product {
        background: white;

        border-radius: 6px;

        overflow: hidden;

        box-shadow:
            0 3px 12px rgba(0,0,0,.08);

        transition: .25s;
    }

    .product:hover {
        transform: translateY(-5px);

        box-shadow:
            0 8px 25px rgba(0,0,0,.15);
    }

    .product-img {
        width: 100%;
        height: 330px;

        object-fit: cover;

        display: block;
    }

    .product-info {
        padding: 18px;
    }

    .product-name {
        font-size: 17px;
        font-weight: bold;

        margin-bottom: 10px;

        min-height: 40px;
    }

    .product-price {
        color: #e63946;

        font-size: 18px;
        font-weight: bold;
    }

    .product-btn {
        display: block;

        margin-top: 15px;

        padding: 10px;

        text-align: center;

        border: 1px solid #222;

        color: #222;

        text-decoration: none;

        border-radius: 4px;

        transition: .2s;
    }

    .product-btn:hover {
        background: #111;
        color: white;

        text-decoration: none;
    }

    .empty-products {
        grid-column: 1 / -1;

        background: white;

        padding: 50px;

        text-align: center;

        border-radius: 6px;
    }

    .empty-products h3 {
        margin-bottom: 10px;
    }

    .empty-products p {
        color: #777;
    }


    /* =====================================================
       SALE BANNER
    ===================================================== */

    .banner {
        margin-top: 20px;

        background:
            linear-gradient(
                90deg,
                rgba(0,0,0,.75),
                rgba(0,0,0,.1)
            ),
            url('@Url.Content("~/Content/images/sale-banner.jpg")')
            center/cover;

        min-height: 300px;

        display: flex;
        align-items: center;

        padding: 50px;

        color: white;
    }

    .banner h2 {
        font-size: 38px;
        margin-bottom: 15px;
    }

    .banner p {
        font-size: 17px;
        margin-bottom: 25px;
    }


    /* =====================================================
       FEATURES
    ===================================================== */

    .features {
        display: grid;

        grid-template-columns:
            repeat(4, 1fr);

        gap: 20px;

        margin-top: 30px;
    }

    .feature {
        background: white;

        text-align: center;

        padding: 30px 20px;

        border-radius: 6px;
    }

    .feature-icon {
        font-size: 35px;

        margin-bottom: 15px;
    }

    .feature h3 {
        font-size: 17px;

        margin-bottom: 8px;
    }

    .feature p {
        color: #777;

        font-size: 14px;
    }


    /* =====================================================
       FOOTER
    ===================================================== */

    .tt-footer {
        background: #111;

        color: white;

        padding: 45px 0 20px;

        margin-top: 40px;
    }

    .footer-grid {
        max-width: 1200px;

        margin: auto;

        display: grid;

        grid-template-columns:
            2fr 1fr 1fr 1fr;

        gap: 40px;

        padding: 0 15px;
    }

    .footer-grid h3 {
        margin-bottom: 18px;
    }

    .footer-grid p,
    .footer-grid a {
        color: #bbb;

        font-size: 14px;

        line-height: 1.8;

        text-decoration: none;
    }

    .footer-grid a:hover {
        color: white;
    }

    .footer-bottom {
        max-width: 1200px;

        margin: 30px auto 0;

        padding: 20px 15px 0;

        border-top: 1px solid #333;

        color: #888;

        font-size: 13px;

        text-align: center;
    }


    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @@media (max-width: 900px) {

        .categories,
        .products,
        .features {
            grid-template-columns:
                repeat(2, 1fr);
        }

        .menu {
            display: none;
        }

        .hero-content h1 {
            font-size: 40px;
        }

        .footer-grid {
            grid-template-columns:
                1fr 1fr;
        }
    }


    @@media (max-width: 600px) {

        .categories,
        .products,
        .features {
            grid-template-columns: 1fr;
        }

        .footer-grid {
            grid-template-columns: 1fr;
        }

        .home-search-form {
            flex-direction: column;
        }

        .home-search-form button {
            width: 100%;
        }

        .hero {
            min-height: 400px;
        }

        .hero-content h1 {
            font-size: 32px;
        }

        .hero-content p {
            font-size: 16px;
        }

        .banner {
            padding: 30px 20px;
        }

        .banner h2 {
            font-size: 28px;
        }
    }

</style>


<!-- =====================================================
     HEADER
===================================================== -->

<header class="tt-header">

    <div class="tt-header-inner">


        <!-- LOGO -->

        <a href="@Url.Action("Index", "Home")"
           class="logo">

            THIÊN THAI<span>.</span>

        </a>


        <!-- MENU -->

        <nav class="menu">

            <a href="@Url.Action("Index", "Home")">
                Trang chủ
            </a>

            <a href="@Url.Action("Index", "Product")">
                Sản phẩm
            </a>

            <a href="@Url.Action("BestSeller", "Product")">
                Bán chạy
            </a>

            <a href="@Url.Action("Contact", "Home")">
                Liên hệ
            </a>

        </nav>


        <!-- HEADER ICONS -->

        <div class="header-icons">


            <!-- SEARCH -->

            <a href="javascript:void(0)"
               id="searchToggle"
