@using System.Linq
@model ThienThaiShop.Models.Cart

@{
    ViewBag.Title = "Giỏ hàng - Thiên Thai Shop";

    decimal total = 0;

    if (Model != null && Model.CartItems != null)
    {
        foreach (var item in Model.CartItems)
        {
            if (item.Product != null)
            {
                total += item.Product.Price * item.Quantity;
            }
        }
    }
}

<style>
    .cart-page {
        background: #f7f7f7;
        min-height: 100vh;
        padding-bottom: 70px;
    }

    .cart-header {
        background: #111;
        color: white;
        padding: 50px 20px;
        text-align: center;
    }

        .cart-header h1 {
            margin: 0 0 10px;
            font-size: 38px;
        }

        .cart-header p {
            color: #ccc;
            margin: 0;
        }

    .cart-container {
        max-width: 1200px;
        margin: auto;
        padding: 40px 15px;
    }

    .cart-layout {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 25px;
        align-items: start;
    }

    .cart-box {
        background: white;
        border-radius: 6px;
        box-shadow: 0 3px 12px rgba(0,0,0,.07);
        overflow: hidden;
    }

    .cart-item {
        display: grid;
        grid-template-columns: 120px 1fr auto;
        gap: 20px;
        padding: 20px;
        border-bottom: 1px solid #eee;
        align-items: center;
    }

        .cart-item:last-child {
            border-bottom: none;
        }

    .cart-image {
        width: 120px;
        height: 140px;
        object-fit: cover;
        border-radius: 5px;
    }

    .cart-product-name {
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .cart-size {
        color: #777;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .cart-price {
        color: #e63946;
        font-weight: bold;
        font-size: 17px;
    }

    .quantity-form {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 12px;
    }

        .quantity-form input {
            width: 65px;
            padding: 8px;
            text-align: center;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

    .btn-update {
        padding: 8px 12px;
        background: #111;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

        .btn-update:hover {
            background: #e63946;
        }

    .item-total {
        text-align: right;
        font-weight: bold;
        font-size: 17px;
        margin-bottom: 15px;
    }

    .btn-remove {
        padding: 8px 14px;
        background: white;
        color: #e63946;
        border: 1px solid #e63946;
        border-radius: 4px;
        cursor: pointer;
    }

        .btn-remove:hover {
            background: #e63946;
            color: white;
        }

    .cart-summary {
        background: white;
        padding: 25px;
        border-radius: 6px;
        box-shadow: 0 3px 12px rgba(0,0,0,.07);
    }

        .cart-summary h2 {
            margin-top: 0;
            margin-bottom: 25px;
        }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #eee;
    }

    .summary-total {
        display: flex;
        justify-content: space-between;
        padding: 20px 0;
        font-size: 21px;
        font-weight: bold;
    }

        .summary-total span:last-child {
            color: #e63946;
        }

    .btn-checkout {
        display: block;
        width: 100%;
        padding: 14px;
        background: #e63946;
        color: white;
        text-align: center;
        text-decoration: none;
        border: none;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
        font-size: 15px;
        box-sizing: border-box;
    }

        .btn-checkout:hover {
            background: #c92532;
            color: white;
            text-decoration: none;
        }

    .btn-continue {
        display: block;
        width: 100%;
        padding: 13px;
        margin-top: 10px;
        border: 1px solid #111;
        color: #111;
        text-align: center;
        text-decoration: none;
        border-radius: 4px;
        box-sizing: border-box;
    }

        .btn-continue:hover {
            background: #111;
            color: white;
            text-decoration: none;
        }

    .clear-form {
        padding: 20px;
        text-align: right;
        border-top: 1px solid #eee;
    }

    .btn-clear {
        background: white;
        border: 1px solid #999;
        color: #555;
        padding: 9px 15px;
        border-radius: 4px;
        cursor: pointer;
    }

        .btn-clear:hover {
            border-color: #e63946;
            color: #e63946;
        }

    .empty-cart {
        background: white;
        text-align: center;
        padding: 80px 20px;
        border-radius: 6px;
        box-shadow: 0 3px 12px rgba(0,0,0,.07);
    }

    .empty-cart-icon {
        font-size: 60px;
        margin-bottom: 20px;
    }

    .empty-cart h2 {
        margin-bottom: 10px;
    }

    .empty-cart p {
        color: #777;
        margin-bottom: 25px;
    }

    .btn-shopping {
        display: inline-block;
        background: #111;
        color: white;
        padding: 13px 30px;
        text-decoration: none;
        border-radius: 4px;
        font-weight: bold;
    }

        .btn-shopping:hover {
            background: #e63946;
            color: white;
            text-decoration: none;
        }

    @@media (max-width: 850px) {
        .cart-layout {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .cart-item {
            grid-template-columns: 90px 1fr;
        }

        .cart-image {
            width: 90px;
            height: 110px;
        }

        .cart-actions {
            grid-column: 1 / -1;
        }
    }
</style>


<div class="cart-page">

    <!-- HEADER -->
    <div class="cart-header">

        <h1>
            GIỎ HÀNG
        </h1>

        <p>
            Kiểm tra sản phẩm trước khi đặt hàng
        </p>

    </div>


    <div class="cart-container">

        @if (Model == null ||
             Model.CartItems == null ||
             !Model.CartItems.Any())
        {
            <!-- GIỎ TRỐNG -->

            <div class="empty-cart">

                <div class="empty-cart-icon">
                    🛒
                </div>

                <h2>
                    Giỏ hàng đang trống
                </h2>

                <p>
                    Bạn chưa có sản phẩm nào trong giỏ hàng.
                </p>

                <a href="@Url.Action("Index", "Product")"
                   class="btn-shopping">

                    TIẾP TỤC MUA SẮM

                </a>

            </div>
        }
        else
        {
            <!-- GIỎ CÓ SẢN PHẨM -->

            <div class="cart-layout">

                <!-- DANH SÁCH SẢN PHẨM -->

                <div class="cart-box">

                    @foreach (var item in Model.CartItems)
                    {
                        if (item.Product != null)
                        {
                            <div class="cart-item">

                                <!-- HÌNH ẢNH -->

                                <img class="cart-image"
                                     src="@(string.IsNullOrEmpty(item.Product.ImageUrl)
                                            ? "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=500&q=80"
                                            : item.Product.ImageUrl)"
                                     alt="@item.Product.Name" />


                                <!-- THÔNG TIN -->

                                <div>

                                    <div class="cart-product-name">
                                        @item.Product.Name
                                    </div>


                                    @if (item.Size != null)
                                    {
                                        <div class="cart-size">
                                            Size:
                                            <strong>
                                                @item.Size.Name
                                            </strong>
                                        </div>
                                    }


                                    <div class="cart-price">
                                        @item.Product.Price.ToString("N0")₫
                                    </div>


                                    <!-- CẬP NHẬT SỐ LƯỢNG -->

                                    <form method="post"
                                          action="@Url.Action("UpdateQuantity", "Cart")"
                                          class="quantity-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="cartItemId"
                                               value="@item.CartItemId" />

                                        <input type="number"
                                               name="quantity"
                                               value="@item.Quantity"
                                               min="1"
                                               max="@item.Product.Stock" />

                                        <button type="submit"
                                                class="btn-update">

                                            Cập nhật

                                        </button>

                                    </form>

                                </div>


                                <!-- THAO TÁC -->

                                <div class="cart-actions">

                                    <div class="item-total">

                                        @((item.Product.Price * item.Quantity)
                                            .ToString("N0"))₫

                                    </div>


                                    <form method="post"
                                          action="@Url.Action("Remove", "Cart")">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="cartItemId"
                                               value="@item.CartItemId" />

                                        <button type="submit"
                                                class="btn-remove">

                                            🗑 Xóa

                                        </button>

                                    </form>

                                </div>

                            </div>
                        }
                    }


                    <!-- XÓA TOÀN BỘ -->

                    <div class="clear-form">

                        <form method="post"
                              action="@Url.Action("Clear", "Cart")">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn-clear">

                                🗑 Xóa toàn bộ giỏ hàng

                            </button>

                        </form>

                    </div>

                </div>


                <!-- TỔNG ĐƠN HÀNG -->

                <div class="cart-summary">

                    <h2>
                        Tổng đơn hàng
                    </h2>


                    <div class="summary-row">

                        <span>
                            Tạm tính
                        </span>

                        <span>
                            @total.ToString("N0")₫
                        </span>

                    </div>


                    <div class="summary-row">

                        <span>
                            Phí vận chuyển
                        </span>

                        <span>
                            Tính khi đặt hàng
                        </span>

                    </div>


                    <div class="summary-total">

                        <span>
                            Tổng cộng
                        </span>

                        <span>
                            @total.ToString("N0")₫
                        </span>

                    </div>


                    <!-- ĐI ĐẾN TRANG CHECKOUT -->

                    <a href="@Url.Action("Index", "Checkout")"
                       class="btn-checkout">

                        TIẾN HÀNH ĐẶT HÀNG →

                    </a>


                    <!-- TIẾP TỤC MUA -->

                    <a href="@Url.Action("Index", "Product")"
                       class="btn-continue">

                        ← Tiếp tục mua sắm

                    </a>

                </div>

            </div>
        }

    </div>

</div>