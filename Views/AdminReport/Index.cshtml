@model ThienThaiShop.Models.AdminSalesReportViewModel

@{
    ViewBag.Title = "Báo cáo doanh thu & tồn kho";

    var categories =
        ViewBag.Categories
        as List<ThienThaiShop.Models.Category>;

    string selectedCategory =
        ViewBag.SelectedCategory as string;

    string search =
        ViewBag.Search as string;

    string filterType =
        ViewBag.FilterType as string;

    string selectedDate =
        ViewBag.SelectedDate as string;

    int? selectedMonth =
        ViewBag.SelectedMonth as int?;

    int? selectedYear =
        ViewBag.SelectedYear as int?;

    string selectedFromDate =
        ViewBag.SelectedFromDate as string;

    string selectedToDate =
        ViewBag.SelectedToDate as string;

    bool onlyRestock =
        ViewBag.OnlyRestock != null &&
        (bool)ViewBag.OnlyRestock;

    var fromDate =
        ViewBag.FromDate as DateTime?;

    var toDate =
        ViewBag.ToDate as DateTime?;
}

<style>

    /* ================================
       TRANG CHÍNH
       ================================ */

    .report-page {
        background: #f5f6f8;
        min-height: 100vh;
        padding: 30px 0 70px;
    }

    .report-box {
        background: #fff;
        border-radius: 14px;
        padding: 30px;
        box-shadow: 0 4px 18px rgba(0,0,0,.07);
    }


    /* ================================
       HEADER
       ================================ */

    .report-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
        padding-bottom: 22px;
        border-bottom: 1px solid #eee;
    }

        .report-header h2 {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
            color: #222;
        }

    .report-subtitle {
        color: #777;
        margin-top: 8px;
        line-height: 1.6;
    }

    .header-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }


    /* ================================
       BUTTON
       ================================ */

    .btn-report {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        min-height: 42px;
        border-radius: 7px;
        border: none;
        text-decoration: none;
        cursor: pointer;
        font-weight: 600;
        transition: .2s;
    }

    .btn-black {
        background: #222;
        color: #fff;
    }

        .btn-black:hover {
            background: #000;
            color: #fff;
            text-decoration: none;
        }

    .btn-blue {
        background: #337ab7;
        color: #fff;
    }

        .btn-blue:hover {
            background: #286090;
            color: #fff;
            text-decoration: none;
        }

    .btn-orange {
        background: #f0ad4e;
        color: #fff;
    }

        .btn-orange:hover {
            background: #ec971f;
            color: #fff;
            text-decoration: none;
        }


    /* ================================
       SUMMARY
       ================================ */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 25px;
    }

    .summary-card {
        border: 1px solid #e9e9e9;
        border-radius: 11px;
        padding: 20px;
        background: #fafafa;
        transition: .2s;
    }

        .summary-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,.06);
        }

    .summary-title {
        font-size: 14px;
        color: #777;
        margin-bottom: 9px;
    }

    .summary-value {
        font-size: 25px;
        font-weight: 700;
    }

    .revenue-value {
        color: #d9534f;
    }

    .sold-value {
        color: #337ab7;
    }

    .stock-value {
        color: #5cb85c;
    }

    .restock-value {
        color: #d9534f;
    }


    /* ================================
       BỘ LỌC
       ================================ */

    .filter-box {
        background: #fafafa;
        border: 1px solid #e5e5e5;
        border-radius: 11px;
        padding: 22px;
        margin-bottom: 22px;
    }

    .filter-title {
        font-size: 19px;
        font-weight: 700;
        margin-bottom: 17px;
        color: #222;
    }

    .filter-form {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
    }

        .filter-form input,
        .filter-form select {
            min-height: 42px;
            padding: 9px 12px;
            border: 1px solid #d8d8d8;
            border-radius: 7px;
            background: #fff;
            outline: none;
        }

            .filter-form input:focus,
            .filter-form select:focus {
                border-color: #337ab7;
                box-shadow: 0 0 0 2px rgba(51,122,183,.10);
            }

    .filter-search {
        min-width: 220px;
    }

    .filter-check {
        display: flex;
        align-items: center;
        gap: 7px;
        min-height: 42px;
        padding: 0 12px;
        background: #fff;
        border: 1px solid #d8d8d8;
        border-radius: 7px;
        cursor: pointer;
        margin: 0;
        font-weight: 500;
    }

        .filter-check input {
            min-height: auto;
        }


    /* ================================
       BỘ LỌC NGÀY
       ================================ */

    .date-filter-item {
        display: none;
        margin-top: 15px;
        padding: 16px;
        background: #fff;
        border: 1px solid #e4e4e4;
        border-radius: 9px;
    }

        .date-filter-item.active {
            display: block;
        }

    .date-filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
    }

        .date-filter-row strong {
            color: #444;
        }

    .date-input-group {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .date-input-label {
        font-size: 14px;
        color: #666;
        font-weight: 600;
    }

    .range-separator {
        color: #999;
        font-weight: 700;
        padding: 0 3px;
    }


    /* ================================
       KHOẢNG THỜI GIAN
       ================================ */

    .period-box {
        background: #eef7ff;
        border: 1px solid #cfe6f8;
        border-left: 4px solid #337ab7;
        padding: 14px 17px;
        border-radius: 7px;
        margin-bottom: 18px;
        color: #555;
    }

        .period-box strong {
            color: #222;
        }


    /* ================================
       CẢNH BÁO NHẬP HÀNG
       ================================ */

    .restock-box {
        background: #fff8e6;
        border: 1px solid #f5d78e;
        border-left: 4px solid #f0ad4e;
        border-radius: 8px;
        padding: 15px 18px;
        margin-bottom: 20px;
        color: #8a6d3b;
    }


    /* ================================
       BẢNG
       ================================ */

    .section-title {
        font-size: 20px;
        font-weight: 700;
        margin: 26px 0 15px;
        color: #222;
    }

    .report-table-wrapper {
        overflow-x: auto;
        border: 1px solid #e9e9e9;
        border-radius: 10px;
    }

    .report-table {
        width: 100%;
        min-width: 1150px;
        border-collapse: collapse;
        background: #fff;
    }

        .report-table th,
        .report-table td {
            padding: 13px 11px;
            border-bottom: 1px solid #eee;
            vertical-align: middle;
        }

        .report-table th {
            background: #f7f8fa;
            font-weight: 700;
            white-space: nowrap;
            color: #333;
        }

        .report-table tbody tr:last-child td {
            border-bottom: none;
        }

        .report-table tbody tr:hover {
            background: #fafcff;
        }

    .text-center {
        text-align: center !important;
    }

    .text-right {
        text-align: right !important;
    }


    /* ================================
       MÀU DỮ LIỆU
       ================================ */

    .money {
        color: #d9534f;
        font-weight: 700;
    }

    .sold {
        color: #337ab7;
        font-weight: 700;
    }

    .stock-good {
        color: #398439;
        font-weight: 700;
    }

    .stock-low {
        color: #ec971f;
        font-weight: 700;
    }

    .stock-empty {
        color: #c9302c;
        font-weight: 700;
    }


    /* ================================
       BADGE
       ================================ */

    .badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .badge-good {
        background: #dff0d8;
        color: #3c763d;
    }

    .badge-low {
        background: #fcf8e3;
        color: #8a6d3b;
    }

    .badge-empty {
        background: #f2dede;
        color: #a94442;
    }

    .badge-none {
        background: #eee;
        color: #777;
    }

    .restock-number {
        color: #d9534f;
        font-weight: 700;
        font-size: 15px;
    }


    /* ================================
       EMPTY
       ================================ */

    .empty-report {
        padding: 45px 20px;
        text-align: center;
        color: #777;
        background: #fafafa;
        border: 1px solid #eee;
        border-radius: 10px;
    }


    /* ================================
       GHI CHÚ
       ================================ */

    .note-box {
        margin-top: 25px;
        padding: 16px 18px;
        background: #f8f9fa;
        border: 1px solid #e8e8e8;
        border-left: 4px solid #337ab7;
        border-radius: 7px;
        line-height: 1.8;
        color: #555;
    }


    /* ================================
       RESPONSIVE
       ================================ */

    @@media (max-width: 1000px) {

        .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .report-header {
            align-items: flex-start;
        }
    }


    @@media (max-width: 600px) {

        .report-page {
            padding-top: 15px;
        }

        .report-box {
            padding: 18px;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .report-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .filter-form,
        .date-filter-row {
            flex-direction: column;
            align-items: stretch;
        }

            .filter-form input,
            .filter-form select,
            .date-filter-row input,
            .date-filter-row select {
                width: 100%;
            }

        .date-input-group {
            flex-direction: column;
            align-items: stretch;
        }

        .range-separator {
            display: none;
        }

        .header-buttons {
            width: 100%;
        }

            .header-buttons .btn-report {
                flex: 1;
            }
    }
</style>


<div class="report-page">

    <div class="container">

        <div class="report-box">


            <!-- ================================
                 HEADER
                 ================================ -->

            <div class="report-header">

                <div>

                    <h2>
                        📊 Báo cáo doanh thu & tồn kho
                    </h2>

                    <div class="report-subtitle">

                        Theo dõi doanh thu, số lượng đã bán,
                        tồn kho theo từng Size và đề xuất nhập hàng.

                    </div>

                </div>


                <div class="header-buttons">

                    <a href="@Url.Action("Index", "Admin")"
                       class="btn-report btn-black">

                        ← Dashboard

                    </a>

                    <a href="@Url.Action("Products", "Admin")"
                       class="btn-report btn-blue">

                        📦 Sản phẩm

                    </a>

                </div>

            </div>


            <!-- ================================
                 TỔNG QUAN
                 ================================ -->

            <div class="summary-grid">


                <div class="summary-card">

                    <div class="summary-title">
                        💰 Tổng doanh thu
                    </div>

                    <div class="summary-value revenue-value">

                        @Model.TotalRevenue.ToString("N0") ₫

                    </div>

                </div>


                <div class="summary-card">

                    <div class="summary-title">
                        🛒 Số lượng đã bán
                    </div>

                    <div class="summary-value sold-value">

                        @Model.TotalSold

                    </div>

                </div>


                <div class="summary-card">

                    <div class="summary-title">
                        📦 Hàng tồn hiện tại
                    </div>

                    <div class="summary-value stock-value">

                        @Model.TotalStock

                    </div>

                </div>


                <div class="summary-card">

                    <div class="summary-title">
                        ⚠️ Size cần nhập
                    </div>

                    <div class="summary-value restock-value">

                        @Model.RestockSizeCount

                    </div>

                    <div style="
                        color:#777;
                        margin-top:5px;
                        font-size:13px;
                    ">

                        Đề xuất nhập:

                        <strong>
                            @Model.RestockQuantity
                        </strong>

                        sản phẩm

                    </div>

                </div>

            </div>


            <!-- ================================
                 BỘ LỌC
                 ================================ -->

            <div class="filter-box">

                <div class="filter-title">

                    🔎 Bộ lọc doanh thu & tồn kho

                </div>


                @using (Html.BeginForm(
                    "Index",
                    "AdminReport",
                    FormMethod.Get))
                {

                    <div class="filter-form">


                        <!-- TÌM SẢN PHẨM -->

                        <input type="text"
                               name="search"
                               value="@search"
                               class="filter-search"
                               placeholder="🔍 Tìm tên sản phẩm..." />


                        <!-- DANH MỤC -->

                        <select name="category">

                            <option value="">
                                Tất cả danh mục
                            </option>

                            @if (categories != null)
                            {
                                foreach (var item in categories)
                                {
                                    if (selectedCategory == item.Name)
                                    {
                                        <option value="@item.Name"
                                                selected="selected">

                                            @item.Name

                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@item.Name">

                                            @item.Name

                                        </option>
                                    }
                                }
                            }

                        </select>


                        <!-- KIỂU THỜI GIAN -->

                        <select name="filterType"
                                id="filterType">

                            <option value="all"
                                    @(filterType == "all" ? "selected" : "")>

                                Tất cả thời gian

                            </option>

                            <option value="today"
                                    @(filterType == "today" ? "selected" : "")>

                                Hôm nay

                            </option>

                            <option value="day"
                                    @(filterType == "day" ? "selected" : "")>

                                Theo ngày

                            </option>

                            <option value="month"
                                    @(filterType == "month" ? "selected" : "")>

                                Theo tháng

                            </option>

                            <option value="year"
                                    @(filterType == "year" ? "selected" : "")>

                                Theo năm

                            </option>

                            <option value="range"
                                    @(filterType == "range" ? "selected" : "")>

                                📅 Từ ngày đến ngày

                            </option>

                        </select>


                        <!-- CHỈ XEM SIZE CẦN NHẬP -->

                        <label class="filter-check">

                            <input type="checkbox"
                                   name="onlyRestock"
                                   value="true"
                                   @(onlyRestock ? "checked" : "") />

                            ⚠️ Chỉ xem size cần nhập

                        </label>


                        <!-- NÚT LỌC -->

                        <button type="submit"
                                class="btn-report btn-black">

                            🔎 Lọc báo cáo

                        </button>


                        <!-- XÓA LỌC -->

                        <a href="@Url.Action("Index", "AdminReport")"
                           class="btn-report btn-orange">

                            ↻ Xóa lọc

                        </a>

                    </div>


                    <!-- ================================
                         THEO NGÀY
                         ================================ -->

                    <div id="dayFilter"
                         class="date-filter-item
                         @(filterType == "day" ? "active" : "")">

                        <div class="date-filter-row">

                            <div class="date-input-group">

                                <span class="date-input-label">
                                    Chọn ngày:
                                </span>

                                <input type="date"
                                       name="selectedDate"
                                       value="@selectedDate" />

                            </div>

                        </div>

                    </div>


                    <!-- ================================
                         THEO THÁNG
                         ================================ -->

                    <div id="monthFilter"
                         class="date-filter-item
                         @(filterType == "month" ? "active" : "")">

                        <div class="date-filter-row">

                            <div class="date-input-group">

                                <span class="date-input-label">
                                    Tháng:
                                </span>

                                <select name="selectedMonth">

                                    @for (
                                        int month = 1;
                                        month <= 12;
                                        month++)
                                    {
                                        <option value="@month"
                                                @(selectedMonth == month ? "selected" : "")>

                                            Tháng @month

                                        </option>
                                    }

                                </select>

                            </div>


                            <div class="date-input-group">

                                <span class="date-input-label">
                                    Năm:
                                </span>

                                <select name="selectedYear">

                                    @for (
                                        int year = DateTime.Now.Year;
                                        year >= 2020;
                                        year--)
                                    {
                                        <option value="@year"
                                                @(selectedYear == year ? "selected" : "")>

                                            @year

                                        </option>
                                    }

                                </select>

                            </div>

                        </div>

                    </div>


                    <!-- ================================
                         THEO NĂM
                         ================================ -->

                    <div id="yearFilter"
                         class="date-filter-item
                         @(filterType == "year" ? "active" : "")">

                        <div class="date-filter-row">

                            <div class="date-input-group">

                                <span class="date-input-label">
                                    Chọn năm:
                                </span>

                                <select name="selectedYear">

                                    @for (
                                        int year = DateTime.Now.Year;
                                        year >= 2020;
                                        year--)
                                    {
                                        <option value="@year"
                                                @(selectedYear == year ? "selected" : "")>

                                            @year

                                        </option>
                                    }

                                </select>

                            </div>

                        </div>

                    </div>


                    <!-- ================================
                         TỪ NGÀY ĐẾN NGÀY
                         ================================ -->

                    <div id="rangeFilter"
                         class="date-filter-item
                         @(filterType == "range" ? "active" : "")">

                        <div class="date-filter-row">

                            <div class="date-input-group">

                                <span class="date-input-label">
                                    📅 Từ ngày:
                                </span>

                                <input type="date"
                                       name="selectedFromDate"
                                       value="@selectedFromDate" />

                            </div>


                            <span class="range-separator">
                                →
                            </span>


                            <div class="date-input-group">

                                <span class="date-input-label">
                                    📅 Đến ngày:
                                </span>

                                <input type="date"
                                       name="selectedToDate"
                                       value="@selectedToDate" />

                            </div>

                        </div>

                    </div>

                }

            </div>


            <!-- ================================
                 KHOẢNG THỜI GIAN ĐANG XEM
                 ================================ -->

            @if (fromDate.HasValue &&
                 toDate.HasValue)
            {
                <div class="period-box">

                    📅 Đang xem doanh thu từ

                    <strong>
                        @fromDate.Value.ToString("dd/MM/yyyy HH:mm")
                    </strong>

                    đến

                    <strong>
                        @toDate.Value
                        .AddSeconds(-1)
                        .ToString("dd/MM/yyyy HH:mm")
                    </strong>

                </div>
            }
            else
            {
                <div class="period-box">

                    📅 Đang xem

                    <strong>
                        toàn bộ thời gian
                    </strong>

                </div>
            }


            <!-- ================================
                 CẢNH BÁO NHẬP HÀNG
                 ================================ -->

            @if (Model.RestockSizeCount > 0)
            {
                <div class="restock-box">

                    ⚠️ Có

                    <strong>
                        @Model.RestockSizeCount
                    </strong>

                    size đang có tồn kho thấp.

                    Đề xuất nhập thêm:

                    <strong>
                        @Model.RestockQuantity
                    </strong>

                    sản phẩm.

                </div>
            }


            <!-- ================================
                 BẢNG CHI TIẾT
                 ================================ -->

            <div class="section-title">

                📋 Chi tiết doanh thu & tồn kho theo Size

            </div>


            @if (Model.Rows == null ||
                 !Model.Rows.Any())
            {
                <div class="empty-report">

                    Không có dữ liệu phù hợp với bộ lọc.

                </div>
            }
            else
            {
                <div class="report-table-wrapper">

                    <table class="report-table">

                        <thead>

                            <tr>

                                <th>
                                    Sản phẩm
                                </th>

                                <th>
                                    Danh mục
                                </th>

                                <th class="text-center">
                                    Size
                                </th>

                                <th class="text-right">
                                    Giá
                                </th>

                                <th class="text-center">
                                    Đã bán
                                </th>

                                <th class="text-right">
                                    Doanh thu
                                </th>

                                <th class="text-center">
                                    Tồn kho
                                </th>

                                <th class="text-center">
                                    Trạng thái
                                </th>

                                <th class="text-center">
                                    Nên nhập
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var row in Model.Rows)
                            {

                                <tr>


                                    <!-- SẢN PHẨM -->

                                    <td>

                                        <strong>
                                            @row.ProductName
                                        </strong>

                                        <div style="
                                            color:#999;
                                            font-size:12px;
                                            margin-top:3px;
                                        ">

                                            ID:
                                            @row.ProductId

                                        </div>

                                    </td>


                                    <!-- DANH MỤC -->

                                    <td>
                                        @row.CategoryName
                                    </td>


                                    <!-- SIZE -->

                                    <td class="text-center">

                                        <strong>
                                            @row.SizeName
                                        </strong>

                                    </td>


                                    <!-- GIÁ -->

                                    <td class="text-right">

                                        @row.UnitPrice.ToString("N0")
                                        ₫

                                    </td>


                                    <!-- ĐÃ BÁN -->

                                    <td class="text-center sold">

                                        @row.QuantitySold

                                    </td>


                                    <!-- DOANH THU -->

                                    <td class="text-right money">

                                        @row.Revenue.ToString("N0")
                                        ₫

                                    </td>


                                    <!-- TỒN KHO -->

                                    <td class="text-center">

                                        @if (!row.IsSizeConfigured)
                                        {
                                            <span class="
                                                badge
                                                badge-none">

                                                Chưa thiết lập

                                            </span>
                                        }
                                        else if (row.CurrentStock <= 0)
                                        {
                                            <span class="stock-empty">

                                                0

                                            </span>
                                        }
                                        else if (row.CurrentStock <= 5)
                                        {
                                            <span class="stock-low">

                                                @row.CurrentStock

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="stock-good">

                                                @row.CurrentStock

                                            </span>
                                        }

                                    </td>


                                    <!-- TRẠNG THÁI -->

                                    <td class="text-center">

                                        @if (!row.IsSizeConfigured)
                                        {
                                            <span class="
                                                badge
                                                badge-none">

                                                Chưa thiết lập

                                            </span>
                                        }
                                        else if (row.CurrentStock <= 0)
                                        {
                                            <span class="
                                                badge
                                                badge-empty">

                                                Hết hàng

                                            </span>
                                        }
                                        else if (row.CurrentStock <= 5)
                                        {
                                            <span class="
                                                badge
                                                badge-low">

                                                ⚠ Nên nhập

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="
                                                badge
                                                badge-good">

                                                ✓ Đủ hàng

                                            </span>
                                        }

                                    </td>


                                    <!-- NÊN NHẬP -->

                                    <td class="text-center">

                                        @if (row.ShouldRestock)
                                        {
                                            <span class="restock-number">

                                                +@row.SuggestedRestock

                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                —
                                            </span>
                                        }

                                    </td>


                                </tr>

                            }

                        </tbody>

                    </table>

                </div>
            }


            <!-- ================================
                 GIẢI THÍCH
                 ================================ -->

            <div class="note-box">

                <strong>
                    ℹ️ Giải thích báo cáo
                </strong>

                <br />

                • <strong>Đã bán</strong> và
                <strong>Doanh thu</strong> chỉ tính các đơn
                <strong>Completed</strong> hoặc
                <strong>Delivered</strong>.

                <br />

                • Khi chọn
                <strong>ngày / tháng / năm / từ ngày đến ngày</strong>,
                chỉ <strong>doanh thu và số lượng bán</strong>
                được lọc theo khoảng thời gian.

                <br />

                • <strong>Tồn kho</strong> luôn hiển thị số tồn
                hiện tại của từng Size.

                <br />

                • <strong>Chưa thiết lập</strong> nghĩa là sản phẩm
                chưa có dữ liệu tồn kho riêng cho Size đó trong
                bảng ProductSize.

                <br />

                • Size có tồn kho từ
                <strong>0 đến 5</strong> được đánh dấu
                <strong>nên nhập</strong>.

                <br />

                • Mức nhập đề xuất là đưa tồn kho lên
                <strong>10 sản phẩm / Size</strong>.

            </div>


        </div>

    </div>

</div>


<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            var filterType =
                document.getElementById("filterType");

            var dayFilter =
                document.getElementById("dayFilter");

            var monthFilter =
                document.getElementById("monthFilter");

            var yearFilter =
                document.getElementById("yearFilter");

            var rangeFilter =
                document.getElementById("rangeFilter");


            function updateDateFilters() {

                var value = filterType.value;


                dayFilter.classList.remove("active");

                monthFilter.classList.remove("active");

                yearFilter.classList.remove("active");

                rangeFilter.classList.remove("active");


                if (value === "day") {

                    dayFilter.classList.add("active");

                }
                else if (value === "month") {

                    monthFilter.classList.add("active");

                }
                else if (value === "year") {

                    yearFilter.classList.add("active");

                }
                else if (value === "range") {

                    rangeFilter.classList.add("active");

                }

            }


            filterType.addEventListener(
                "change",
                updateDateFilters
            );


            updateDateFilters();

        }
    );

</script>