@using System.Linq

@{
    ViewBag.Title = "Đặt hàng - Thiên Thai Shop";

    var user = ViewBag.User as ThienThaiShop.Models.ApplicationUser;
    var cartItems = ViewBag.CartItems as System.Collections.Generic.List<ThienThaiShop.Models.CartItem>;

    decimal total = ViewBag.Total != null
        ? (decimal)ViewBag.Total
        : 0;
}

<style>
    .checkout-page {
        background: #f7f7f7;
        min-height: 100vh;
        padding-bottom: 70px;
    }

    .checkout-header {
        background: #111;
        color: white;
        padding: 45px 20px;
        text-align: center;
    }

        .checkout-header h1 {
            margin: 0 0 10px;
            font-size: 36px;
        }

        .checkout-header p {
            margin: 0;
            color: #ccc;
        }

    .checkout-container {
        max-width: 1100px;
        margin: auto;
        padding: 40px 15px;
    }

    .checkout-layout {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 25px;
        align-items: start;
    }

    .checkout-box {
        background: white;
        padding: 30px;
        border-radius: 6px;
        box-shadow: 0 3px 12px rgba(0,0,0,.07);
    }

        .checkout-box h2 {
            margin-top: 0;
            margin-bottom: 25px;
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            font-weight: bold;
            margin-bottom: 8px;
        }

    .form-control {
        width: 100%;
        box-sizing: border-box;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 15px;
    }

    textarea.form-control {
        min-height: 100px;
        resize: vertical;
    }

    .payment-option {
        border: 1px solid #ddd;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 10px;
    }

        .payment-option input {
            margin-right: 8px;
        }

    .checkout-summary {
        background: white;
        padding: 25px;
        border-radius: 6px;
        box-shadow: 0 3px 12px rgba(0,0,0,.07);
    }

        .checkout-summary h2 {
            margin-top: 0;
            margin-bottom: 20px;
        }

    .checkout-item {
        padding: 12px 0;
        border-bottom: 1px solid #eee;
    }

    .checkout-item-name {
        font-weight: bold;
        margin-bottom: 5px;
    }

    .checkout-item-info {
        color: #777;
        font-size: 14px;
    }

    .checkout-item-price {
        color: #e63946;
        font-weight: bold;
        margin-top: 5px;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        padding-top: 20px;
        font-size: 20px;
        font-weight: bold;
    }

        .total-row span:last-child {
            color: #e63946;
        }

    .btn-order {
        width: 100%;
        padding: 15px;
        margin-top: 25px;
        background: #e63946;
        color: white;
        border: none;
        border-radius: 4px;
        font-weight: bold;
        font-size: 16px;
        cursor: pointer;
    }

        .btn-order:hover {
            background: #c92532;
        }

    .btn-back {
        display: block;
        text-align: center;
        margin-top: 15px;
        padding: 12px;
        border: 1px solid #111;
        color: #111;
        text-decoration: none;
        border-radius: 4px;
    }

        .btn-back:hover {
            background: #111;
            color: white;
        }

    .error-message {
        background: #ffe5e5;
        color: #c92532;
        padding: 12px;
        margin-bottom: 20px;
        border-radius: 4px;
    }

    @@media (max-width: 800px) {
        .checkout-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="checkout-page">

    <div class="checkout-header">

        <h1>ĐẶT HÀNG</h1>

        <p>
            Nhập thông tin giao hàng để hoàn tất đơn hàng
        </p>

    </div>

    <div class="checkout-container">

        @if (TempData["Error"] != null)
        {
            <div class="error-message">
                @TempData["Error"]
            </div>
        }

        <div class="checkout-layout">

            <!-- THÔNG TIN GIAO HÀNG -->

            <div class="checkout-box">

                <h2>
                    Thông tin giao hàng
                </h2>

                <form method="post"
                      action="@Url.Action("PlaceOrder", "Checkout")">

                    @Html.AntiForgeryToken()

                    <div class="form-group">

                        <label>
                            Họ và tên
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@(user != null ? user.FullName : "")"
                               readonly />

                    </div>

                    <div class="form-group">

                        <label>
                            Email
                        </label>

                        <input type="email"
                               class="form-control"
                               value="@(user != null ? user.Email : "")"
                               readonly />

                    </div>

                    <div class="form-group">

                        <label>
                            Số điện thoại *
                        </label>

                        <input type="text"
                               name="phone"
                               class="form-control"
                               value="@(user != null ? user.Phone : "")"
                               placeholder="Nhập số điện thoại"
                               required />

                    </div>

                    <div class="form-group">

                        <label>
                            Địa chỉ giao hàng *
                        </label>

                        <textarea name="shippingAddress"
                                  class="form-control"
                                  placeholder="Nhập địa chỉ nhận hàng"
                                  required>@(user != null ? user.Address : "")</textarea>

                    </div>

                    <div class="form-group">

                        <label>
                            Phương thức thanh toán
                        </label>

                        <div class="payment-option">

                            <label>

                                <input type="radio"
                                       name="paymentMethod"
                                       value="COD"
                                       checked />

                                Thanh toán khi nhận hàng (COD)

                            </label>

                        </div>

                        <div class="payment-option">

                            <label>

                                <input type="radio"
                                       name="paymentMethod"
                                       value="Banking" />

                                Chuyển khoản ngân hàng

                            </label>

                        </div>

                    </div>

                    <button type="submit"
                            class="btn-order">

                        XÁC NHẬN ĐẶT HÀNG

                    </button>

                    <a href="@Url.Action("Index", "Cart")"
                       class="btn-back">

                        ← Quay lại giỏ hàng

                    </a>

                </form>

            </div>

            <!-- TÓM TẮT ĐƠN HÀNG -->

            <div class="checkout-summary">

                <h2>
                    Đơn hàng của bạn
                </h2>

                @if (cartItems != null)
                {
                    foreach (var item in cartItems)
                    {
                        if (item.Product != null)
                        {
                            <div class="checkout-item">

                                <div class="checkout-item-name">
                                    @item.Product.Name
                                </div>

                                <div class="checkout-item-info">

                                    Size:
                                    @(item.Size != null
                                        ? item.Size.Name
                                        : "N/A")
                                    × @item.Quantity

                                </div>

                                <div class="checkout-item-price">

                                    @((item.Product.Price * item.Quantity)
                                        .ToString("N0"))đ

                                </div>

                            </div>
                        }
                    }
                }

                <div class="total-row">

                    <span>
                        Tổng cộng
                    </span>

                    <span>
                        @total.ToString("N0")đ
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>