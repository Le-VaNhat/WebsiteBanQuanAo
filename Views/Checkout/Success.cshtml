@model ThienThaiShop.Models.Order

@{
    ViewBag.Title = "Đặt hàng thành công - Thiên Thai Shop";
}

<style>

    .success-page {
        background: #f7f7f7;
        min-height: 100vh;
        padding: 60px 15px;
    }

    .success-box {
        max-width: 750px;
        margin: auto;
        background: white;
        padding: 45px;
        border-radius: 8px;
        box-shadow: 0 3px 15px rgba(0,0,0,.08);
        text-align: center;
    }

    .success-icon {
        font-size: 65px;
        margin-bottom: 20px;
    }

    .success-box h1 {
        margin-bottom: 10px;
    }

    .success-message {
        color: #555;
        margin-bottom: 30px;
    }

    .order-info {
        text-align: left;
        border-top: 1px solid #eee;
        padding-top: 25px;
    }

    .order-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #eee;
        gap: 20px;
    }

        .order-row span:last-child {
            text-align: right;
        }

    .order-total {
        font-size: 20px;
        font-weight: bold;
    }

        .order-total span:last-child {
            color: #e63946;
        }

    .btn-home {
        display: inline-block;
        margin-top: 30px;
        background: #111;
        color: white;
        padding: 13px 30px;
        text-decoration: none;
        border-radius: 4px;
        font-weight: bold;
    }

        .btn-home:hover {
            background: #e63946;
            color: white;
            text-decoration: none;
        }

    @@media (max-width: 600px) {
        .success-box {
            padding: 30px 20px;
        }

        .order-row {
            flex-direction: column;
            gap: 5px;
        }

            .order-row span:last-child {
                text-align: left;
            }
    }
</style>

<div class="success-page">

    <div class="success-box">

        <div class="success-icon">
            ✅
        </div>

        <h1>
            Đặt hàng thành công!
        </h1>

        <p class="success-message">
            Cảm ơn bạn đã mua hàng tại Thiên Thai Shop.
        </p>

        <div class="order-info">

            <div class="order-row">

                <span>
                    Mã đơn hàng
                </span>

                <strong>
                    #@Model.OrderId
                </strong>

            </div>

            <div class="order-row">

                <span>
                    Địa chỉ giao hàng
                </span>

                <span>
                    @Model.ShippingAddress
                </span>

            </div>

            <div class="order-row">

                <span>
                    Số điện thoại
                </span>

                <span>
                    @Model.Phone
                </span>

            </div>

            <div class="order-row">

                <span>
                    Thanh toán
                </span>

                <span>
                    @(Model.PaymentMethod == "COD"
                        ? "Thanh toán khi nhận hàng"
                        : "Chuyển khoản ngân hàng")
                </span>

            </div>

            <div class="order-row">

                <span>
                    Trạng thái
                </span>

                <span>
                    @Model.Status
                </span>

            </div>

            <div class="order-row order-total">

                <span>
                    Tổng tiền
                </span>

                <span>
                    @Model.TotalAmount.ToString("N0")đ
                </span>

            </div>

        </div>

        <a href="@Url.Action("Index", "Home")"
           class="btn-home">

            VỀ TRANG CHỦ

        </a>

    </div>

</div>